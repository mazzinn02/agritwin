    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { ViewMode, DigitalTwinCropState } from \'./types\';\nimport { INITIAL_TWIN_STATE } from \'./data/sampleCrops\';\nimport { Header } from \'./components/Header\';\nimport { DigitalTwinCanvas } from \'./components/DigitalTwinCanvas\';\nimport { ParameterGrid } from \'./components/ParameterGrid\';\nimport { AnalyticsCharts } from \'./components/AnalyticsCharts\';\nimport { AiVisionScanner } from \'./components/AiVisionScanner\';\nimport { BlueprintArchitecture } from \'./components/BlueprintArchitecture\';\nimport { PresentationSlidesExport } from \'./components/PresentationSlidesExport\';\nimport { ClientHowItWorks } from \'./components/ClientHowItWorks\';\n\nexport default function App() {\n  const [currentView, setCurrentView] = useState<ViewMode>(\'twin\');\n  const [twinState, setTwinState] = useState<DigitalTwinCropState>(INITIAL_TWIN_STATE);\n\n  const handleUpdateTwinState = (updated: Partial<DigitalTwinCropState>) => {\n    setTwinState((prev) => ({\n      ...prev,\n      ...updated,\n    }));\n  };\n\n  const handleDayChange = (day: number) => {\n    // Calculate realistic plant parameter growth scaling over 90 days\n    const ratio = day / 90;\n    const baseHeight = 150; // max average height\n    const calculatedHeight = Math.min(220, Math.max(10, Math.pow(ratio, 1.2) * baseHeight));\n    const calculatedCanopy = Math.min(98, Math.max(10, Math.sin(ratio * Math.PI * 0.8) * 95));\n    const calculatedRipeness = day < 35 ? 0 : Math.min(100, Math.pow((day - 35) / 55, 1.4) * 100);\n\n    setTwinState((prev) => ({\n      ...prev,\n      currentDay: day,\n      plantHeightCm: calculatedHeight,\n      canopyCoveragePercent: calculatedCanopy,\n      fruitRipenessPercent: calculatedRipeness,\n      stage:\n        day < 15\n          ? \'Germination\'\n          : day < 35\n          ? \'Vegetative\'\n          : day < 55\n          ? \'Flowering\'\n          : day < 80\n          ? \'Fruit Set\'\n          : \'Harvest Ready\',\n    }));\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#E4E3E0] text-[#141414] font-sans antialiased selection:bg-[#141414] selection:text-white\">\n      {/* Top Sticky Header & View Selector */}\n      <Header\n        currentView={currentView}\n        onSelectView={setCurrentView}\n        twinState={twinState}\n        onUpdateCrop={(newCrop) => setTwinState(newCrop)}\n        onDayChange={handleDayChange}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n        {currentView === \'twin\' && (\n          <div className=\"space-y-8\">\n            <DigitalTwinCanvas\n              twinState={twinState}\n              onStateChange={handleUpdateTwinState}\n            />\n            <ParameterGrid\n              twinState={twinState}\n              onUpdateState={handleUpdateTwinState}\n            />\n          </div>\n        )}\n\n        {currentView === \'analytics\' && (\n          <AnalyticsCharts twinState={twinState} />\n        )}\n\n        {currentView === \'scanner\' && (\n          <AiVisionScanner\n            twinState={twinState}\n            onApplyAnalysisToTwin={(extracted) => {\n              handleUpdateTwinState(extracted);\n              setCurrentView(\'twin\');\n            }}\n          />\n        )}\n\n        {currentView === \'blueprint\' && (\n          <BlueprintArchitecture />\n        )}\n\n        {currentView === \'presentation\' && (\n          <PresentationSlidesExport twinState={twinState} />\n        )}\n\n        {currentView === \'how-it-works\' && (\n          <ClientHowItWorks />\n        )}\n      </main>\n\n      {/* Footer */}\n      <footer className=\"border-t border-[#141414] bg-[#F9F9F9] py-4 text-center text-[10px] font-mono text-[#141414]/70 uppercase\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2\">\n          <span>AgriTwin \342\200\242 College Group Project Digital Twin Blueprint</span>\n          <span>Powered by Express, Gemini 2.5 Flash AI, React 19 & Google Slides API</span>\n        </div>\n      </footer>\n    </div>\n  );\n}"
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { ViewMode, DigitalTwinCropState } from \'./types\';\nimport { INITIAL_TWIN_STATE } from \'./data/sampleCrops\';\nimport { Layout } from \'./components/Layout\';\nimport { LoginScreen } from \'./components/LoginScreen\';\nimport { DigitalTwinCanvas } from \'./components/DigitalTwinCanvas\';\n// Import other views we will create or adapt\nimport { MainDashboard } from \'./components/MainDashboard\';\nimport { DiseaseDetection } from \'./components/DiseaseDetection\';\nimport { GrowthAnalytics } from \'./components/GrowthAnalytics\';\nimport { FruitRipeness } from \'./components/FruitRipeness\';\nimport { YieldPrediction } from \'./components/YieldPrediction\';\nimport { SensorMonitoring } from \'./components/SensorMonitoring\';\nimport { AlertsNotifications } from \'./components/AlertsNotifications\';\nimport { auth } from \'./lib/firebase\';\nimport { onAuthStateChanged } from \'firebase/auth\';\n\nexport default function App() {\n  const [isAuthenticated, setIsAuthenticated] = useState(false);\n  const [currentView, setCurrentView] = useState<ViewMode>(\'dashboard\');\n  const [twinState, setTwinState] = useState<DigitalTwinCropState>(INITIAL_TWIN_STATE);\n\n  useEffect(() => {\n    const unsubscribe = onAuthStateChanged(auth, (user) => {\n      if (user) {\n        setIsAuthenticated(true);\n      } else {\n        setIsAuthenticated(false);\n      }\n    });\n    return () => unsubscribe();\n  }, []);\n\n  const handleUpdateTwinState = (updated: Partial<DigitalTwinCropState>) => {\n    setTwinState((prev) => ({\n      ...prev,\n      ...updated,\n    }));\n  };\n\n  if (!isAuthenticated) {\n    return <LoginScreen onLogin={() => setIsAuthenticated(true)} />;\n  }\n\n  return (\n    <Layout \n      currentView={currentView} \n      onSelectView={setCurrentView}\n      onLogout={() => {\n        auth.signOut();\n        setIsAuthenticated(false);\n      }}\n    >\n      {currentView === \'dashboard\' && <MainDashboard twinState={twinState} />}\n      {currentView === \'twin\' && (\n        <div className=\"space-y-6\">\n          <h2 className=\"text-2xl font-bold text-slate-900\">Virtual Plant Representation</h2>\n          <DigitalTwinCanvas twinState={twinState} onStateChange={handleUpdateTwinState} />\n        </div>\n      )}\n      {currentView === \'disease\' && <DiseaseDetection twinState={twinState} onUpdate={handleUpdateTwinState} />}\n      {currentView === \'growth\' && <GrowthAnalytics twinState={twinState} />}\n      {currentView === \'ripeness\' && <FruitRipeness twinState={twinState} />}\n      {currentView === \'yield\' && <YieldPrediction twinState={twinState} />}\n      {currentView === \'sensors\' && <SensorMonitoring twinState={twinState} />}\n      {currentView === \'alerts\' && <AlertsNotifications twinState={twinState} />}\n    </Layout>\n  );\n}"
    }
