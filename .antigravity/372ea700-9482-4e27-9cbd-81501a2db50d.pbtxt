  file_change {
    absolute_path_uri: "file:///src/data/architectureBlueprint.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { ArchitectureComponent } from \'../types\';\n\nexport const SYSTEM_BLUEPRINT_STAGES = [\n  {\n    step: 1,\n    title: \'Physical Crop Environment & IoT Sensors\',\n    subtitle: \'Hardware Edge Sensing\',\n    description: \'Ground nodes measure soil moisture, temperature, humidity, CO2, and light intensity. Overhead RGB/LiDAR cameras capture stereo spatial images of plants.\',\n    tech: [\'ESP32 / Raspberry Pi 4\', \'Soil Moisture Sensors\', \'LiDAR & Stereo Cameras\', \'LoRaWAN Long Range Gateway\'],\n    icon: \'Radio\',\n    color: \'from-emerald-500 to-teal-600\',\n  },\n  {\n    step: 2,\n    title: \'Telemetry & Image Data Stream Engine\',\n    subtitle: \'Real-time Transport Layer\',\n    description: \'Sensor data is packetized and securely transmitted via MQTT / LoRaWAN to cloud middleware. High-res images are uploaded asynchronously for computer vision processing.\',\n    tech: [\'MQTT Broker (Mosquitto)\', \'WebSockets / REST API\', \'Cloud Storage / S3 Payload\', \'JSON Sensor Protocol\'],\n    icon: \'Wifi\',\n    color: \'from-blue-500 to-cyan-600\',\n  },\n  {\n    step: 3,\n    title: \'Gemini AI Vision & 6-Parameter Extraction\',\n    subtitle: \'Computer Vision & AI Pipeline\',\n    description: \'Multimodal Gemini AI model processes crop photos to calculate Plant Height, Canopy %, Growth Velocity, Disease Identification, Ripeness Ratio, and Yield Projection.\',\n    tech: [\'Google Gemini Multimodal API\', \'OpenCV Preprocessing\', \'RGB/HSV Hue Spectrum Mapping\', \'NDVI Vegetation Indexing\'],\n    icon: \'BrainCircuit\',\n    color: \'from-purple-500 to-indigo-600\',\n  },\n  {\n    step: 4,\n    title: \'Digital Twin State Sync Engine\',\n    subtitle: \'Virtual Replica Synchronization\',\n    description: \'Constructs a mathematical 3D/2D digital twin model in memory. Runs growth differential equations to predict harvest timelines and alert farmers on critical anomalies.\',\n    tech: [\'Virtual Plant State Machine\', \'Biophysical Growth Model\', \'Anomaly Detector\', \'Predictive ML Regressor\'],\n    icon: \'Cpu\',\n    color: \'from-amber-500 to-orange-600\',\n  },\n  {\n    step: 5,\n    title: \'Interactive Web Dashboard & Client API\',\n    subtitle: \'Client Application & Control Suite\',\n    description: \'Full-stack React & Express Web App renders the live twin canvas, parameter dials, time-lapse growth controls, automated Google Slides presentation deck, and mobile views.\',\n    tech: [\'React 19 + TypeScript\', \'Express custom server\', \'Recharts & Motion\', \'Google Slides API / GSI OAuth\'],\n    icon: \'Layout\',\n    color: \'from-pink-500 to-rose-600\',\n  },\n];\n\nexport const TECHNICAL_COMPONENTS: ArchitectureComponent[] = [\n  {\n    id: \'comp-1\',\n    title: \'IoT Sensor Mesh & Field Microcontroller\',\n    layer: \'hardware\',\n    icon: \'Radio\',\n    description: \'Physical sensor array mounted on field posts and solar drones to stream microclimate metrics.\',\n    techStack: [\'ESP32\', \'DHT22\', \'RS485 NPK Sensor\', \'LoRa SX1276\'],\n    roleInProject: \'Captures ground truth physical telemetry every 15 seconds.\',\n  },\n  {\n    id: \'comp-2\',\n    title: \'LiDAR & RGB Vision Pod\',\n    layer: \'hardware\',\n    icon: \'Camera\',\n    description: \'High-definition optical unit measuring plant height canopy contours and leaf spectroradiometry.\',\n    techStack: [\'Intel RealSense D435\', \'LiDAR TFmini\', \'Raspberry Pi HQ Camera\'],\n    roleInProject: \'Feeds visual imagery to height & canopy detection engines.\',\n  },\n  {\n    id: \'comp-3\',\n    title: \'Gemini Multimodal AI Analytics Server\',\n    layer: \'cloud\',\n    icon: \'Sparkles\',\n    description: \'Server-side API processing crop imagery to detect plant diseases, ripeness %, and growth state.\',\n    techStack: [\'@google/genai SDK\', \'Express.js Node API\', \'Gemini 2.5 Flash\'],\n    roleInProject: \'Performs zero-shot image diagnosis and biometric classification.\',\n  },\n  {\n    id: \'comp-4\',\n    title: \'Digital Twin Biophysical Engine\',\n    layer: \'digital-twin\',\n    icon: \'Boxes\',\n    description: \'State machine synchronizing real sensor data with virtual plant growth algorithms.\',\n    techStack: [\'TypeScript State Engine\', \'D3 / Canvas Grid\', \'Yield Prediction Matrix\'],\n    roleInProject: \'Simulates future crop scenarios and computes yield estimates.\',\n  },\n  {\n    id: \'comp-5\',\n    title: \'Google Slides Presentation Generator\',\n    layer: \'web-app\',\n    icon: \'Presentation\',\n    description: \'Client workspace module generating a clean college project deck to showcase system blueprint to clients.\',\n    techStack: [\'Google Slides API v1\', \'GSI OAuth 2.0 Client\', \'REST Presentation Builder\'],\n    roleInProject: \'Exports automated presentation slides directly to Google Drive.\',\n  },\n];\n"
    }
