    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "          return (\n            <div\n              key={param.id}\n              onClick={() => setActiveOverlay(param.id as any)}\n              className={`p-3 border-2 border-[#141414] transition-all cursor-pointer relative overflow-hidden uppercase font-mono ${\n                activeOverlay === param.id\n                  ? \'bg-[#141414] text-[#E4E3E0]\'\n                  : \'bg-white text-[#141414] hover:bg-[#F9F9F9]\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"text-[10px] font-bold truncate\">{param.name.replace(\' Detection\', \'\')}</span>\n                <div\n                  className=\"w-2 h-2 rounded-full\"\n                  style={{ backgroundColor: param.color }}\n                />\n              </div>\n              <div className=\"text-lg font-bold tracking-tight\">{format}</div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Main Canvas & Live Controls Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Interactive Digital Twin Render Stage (8 Cols) */}\n        <div className=\"lg:col-span-8 bg-white border-2 border-[#141414] p-4 relative overflow-hidden\">\n          {/* Header Controls for Canvas */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b-2 border-[#141414]\">\n            <div className=\"flex items-center space-x-2\">\n              <Layers className=\"w-5 h-5 text-[#141414]\" />\n              <h2 className=\"text-sm font-bold uppercase text-[#141414]\">\n                Twin Simulation Stage\n              </h2>\n              <span className=\"text-[10px] px-1.5 py-0.5 bg-[#141414] text-white font-mono uppercase font-bold\">\n                {twinState.cropType} \342\200\242 Stage: {twinState.stage}\n              </span>\n            </div>\n\n            <div className=\"flex items-center space-x-2 font-mono text-[10px] uppercase font-bold\">\n              <span className=\"text-[#141414]\">Overlay:</span>\n              {([\'all\', \'height\', \'canopy\', \'disease\', \'ripeness\'] as const).map((mode) => (\n                <button\n                  key={mode}\n                  onClick={() => setActiveOverlay(mode)}\n                  className={`px-2 py-1 border border-[#141414] transition-colors ${\n                    activeOverlay === mode\n                      ? \'bg-[#141414] text-white\'\n                      : \'bg-white text-[#141414] hover:bg-[#F9F9F9]\'\n                  }`}\n                >\n                  {mode}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Graphical Crop Field Visualization Stage */}\n          <div className=\"relative w-full h-[400px] bg-[#E4E3E0] border-2 border-[#141414] overflow-hidden flex items-center justify-center\">\n            {/* Field Grid Pattern */}\n            <div \n              className=\"absolute inset-0 opacity-20 pointer-events-none\"\n              style={{\n                backgroundImage: `radial-gradient(#141414 1px, transparent 1px)`,\n                backgroundSize: \'24px 24px\',\n              }}\n            />\n\n            {/* IoT Sensor Pulse Node */}\n            <div className=\"absolute top-4 left-4 flex items-center space-x-2 bg-white border-2 border-[#141414] px-2 py-1 font-mono uppercase\">\n              <Radio className=\"w-3.5 h-3.5 text-[#141414] animate-pulse\" />\n              <div>\n                <div className=\"font-bold text-[#141414] text-xs\">{twinState.sensors.id}</div>\n                <div className=\"text-[9px] text-[#141414]/70 font-bold\">{twinState.sensors.name}</div>\n              </div>\n            </div>\n\n            {/* Health Index Meter Overlay */}\n            <div className=\"absolute top-4 right-4 bg-[#141414] text-white border-2 border-[#141414] p-2 text-right uppercase font-mono\">\n              <div className=\"text-[9px] font-bold\">Twin Health Index</div>\n              <div className=\"text-xl font-bold\">{twinState.healthScore}%</div>\n            </div>\n\n            {/* Simulated Plants Row in Canvas */}\n            <div className=\"relative z-10 flex items-end justify-center space-x-6 w-full max-w-xl px-4\">\n              {[0, 1, 2, 3, 4].map((idx) => {\n                // Height calculation scaled for visualization\n                const plantHeightPx = Math.min(260, Math.max(60, twinState.plantHeightCm * 1.8));\n                const canopyWidthPx = Math.min(140, Math.max(50, twinState.canopyCoveragePercent * 1.4));\n                const ripenessColor = getRipenessColor(twinState.fruitRipenessPercent);\n\n                return (\n                  <div key={idx} className=\"flex flex-col items-center group relative\">\n                    {/* Plant Height Annotation */}\n                    {(activeOverlay === \'all\' || activeOverlay === \'height\') && idx === 2 && (\n                      <div className=\"absolute -top-8 bg-white border-2 border-[#141414] text-[#141414] px-1 py-0.5 text-[10px] font-bold uppercase font-mono whitespace-nowrap animate-bounce\">\n                        Height: {twinState.plantHeightCm.toFixed(1)} cm\n                      </div>\n                    )}\n\n                    {/* Disease Alert Highlight */}\n                    {(activeOverlay === \'all\' || activeOverlay === \'disease\') && twinState.diseaseRiskPercent > 12 && idx === 1 && (\n                      <div className=\"absolute -top-10 bg-white border-2 border-red-600 text-red-600 px-1 py-0.5 text-[10px] font-bold uppercase font-mono flex items-center space-x-1 animate-pulse\">\n                        <ShieldAlert className=\"w-3 h-3\" />\n                        <span>Fungal Spot Risk ({twinState.diseaseRiskPercent}%)</span>\n                      </div>\n                    )}\n\n                    {/* Plant SVG Structure */}\n                    <div \n                      className=\"relative flex items-end justify-center transition-all duration-500\"\n                      style={{ height: `${plantHeightPx}px` }}\n                    >\n                      {/* Main Stem */}\n                      <div className=\"w-2.5 bg-gradient-to-t from-emerald-800 to-emerald-500 border border-[#141414] h-full\" />\n\n                      {/* Leaves Canopy Layer */}\n                      <div \n                        className=\"absolute bottom-1/3 rounded-none bg-emerald-500 border-2 border-[#141414] transition-all duration-500\"\n                        style={{\n                          width: `${canopyWidthPx}px`,\n                          height: `${canopyWidthPx * 0.7}px`,\n                          opacity: activeOverlay === \'disease\' && twinState.diseaseRiskPercent > 20 ? 0.6 : 0.9,\n                        }}\n                      />\n\n                      {/* Leaves Detail */}\n                      <div className=\"absolute top-1/4 -left-6 w-8 h-4 bg-emerald-600 border border-[#141414] transform -rotate-25\" />\n                      <div className=\"absolute top-1/4 -right-6 w-8 h-4 bg-emerald-600 border border-[#141414] transform rotate-25\" />\n                      <div className=\"absolute top-2/4 -left-8 w-10 h-5 bg-emerald-500 border border-[#141414] transform -rotate-15\" />\n                      <div className=\"absolute top-2/4 -right-8 w-10 h-5 bg-emerald-500 border border-[#141414] transform rotate-15\" />\n\n                      {/* Fruit/Grain Pods with Ripeness Indicator */}\n                      <div \n                        className=\"absolute top-1/6 w-4 h-4 border-2 border-[#141414] transition-all duration-500 flex items-center justify-center\"\n                        style={{ backgroundColor: ripenessColor }}\n                      >\n                        <div className=\"w-1.5 h-1.5 bg-white\" />\n                      </div>\n                    </div>\n\n                    {/* Ground Root Base & Soil Marker */}\n                    <div className=\"w-20 h-2 bg-[#141414] mt-1\" />\n                  </div>\n                );\n              })}\n            </div>\n\n            {/* Bottom Parameter Legend bar on Canvas */}\n            <div className=\"absolute bottom-3 inset-x-4 bg-white border-2 border-[#141414] p-2 flex flex-wrap items-center justify-between text-[10px] uppercase font-bold font-mono text-[#141414]\">\n              <div className=\"flex items-center space-x-4\">\n                <span className=\"flex items-center space-x-1\">\n                  <Ruler className=\"w-3.5 h-3.5\" />\n                  <span>Height: {twinState.plantHeightCm.toFixed(1)}cm</span>\n                </span>\n                <span className=\"flex items-center space-x-1\">\n                  <Maximize className=\"w-3.5 h-3.5\" />\n                  <span>Canopy: {twinState.canopyCoveragePercent.toFixed(1)}%</span>\n                </span>\n                <span className=\"flex items-center space-x-1\">\n                  <Apple className=\"w-3.5 h-3.5\" />\n                  <span>Ripeness: {twinState.fruitRipenessPercent.toFixed(1)}%</span>\n                </span>\n              </div>\n              <div>\n                Yield Est: {twinState.estimatedYieldKgPerM2.toFixed(1)} kg/m\302\262\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Live Environmental Control & Sensor Suite (4 Cols) */}\n        <div className=\"lg:col-span-4 space-y-4\">\n          {/* Environment Actuator Card */}\n          <div className=\"bg-white border-2 border-[#141414] p-4 space-y-4\">\n            <div className=\"flex items-center justify-between pb-2 border-b-2 border-[#141414]\">\n              <div className=\"flex items-center space-x-2\">\n                <Activity className=\"w-4 h-4 text-[#141414]\" />\n                <h3 className=\"text-sm font-bold uppercase text-[#141414]\">Climate Control</h3>\n              </div>\n              <span className=\"text-[9px] bg-[#141414] text-white px-1.5 py-0.5 uppercase font-bold font-mono\">\n                Interactive\n              </span>\n            </div>\n\n            {/* Temperature Slider */}\n            <div className=\"space-y-1 font-mono uppercase font-bold text-xs text-[#141414]\">\n              <div className=\"flex justify-between\">\n                <span className=\"flex items-center space-x-1\">\n                  <Thermometer className=\"w-3.5 h-3.5\" />\n                  <span>Air Temp</span>\n                </span>\n                <span>{twinState.sensors.temperature}\302\260C</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"10\"\n                max=\"42\"\n                value={twinState.sensors.temperature}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, temperature: parseFloat(e.target.value) },\n                  })\n                }\n                className=\"w-full h-1.5 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n              />\n            </div>\n\n            {/* Humidity Slider */}\n            <div className=\"space-y-1 font-mono uppercase font-bold text-xs text-[#141414]\">\n              <div className=\"flex justify-between\">\n                <span className=\"flex items-center space-x-1\">\n                  <Droplets className=\"w-3.5 h-3.5\" />\n                  <span>Humidity</span>\n                </span>\n                <span>{twinState.sensors.humidity}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"20\"\n                max=\"95\"\n                value={twinState.sensors.humidity}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, humidity: parseInt(e.target.value, 10) },\n                  })\n                }\n                className=\"w-full h-1.5 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n              />\n            </div>\n\n            {/* Soil Moisture Slider */}\n            <div className=\"space-y-1 font-mono uppercase font-bold text-xs text-[#141414]\">\n              <div className=\"flex justify-between\">\n                <span className=\"flex items-center space-x-1\">\n                  <CloudRain className=\"w-3.5 h-3.5\" />\n                  <span>Moisture</span>\n                </span>\n                <span>{twinState.sensors.soilMoisture}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"10\"\n                max=\"90\"\n                value={twinState.sensors.soilMoisture}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, soilMoisture: parseInt(e.target.value, 10) },\n                  })\n                }\n                className=\"w-full h-1.5 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n              />\n            </div>\n\n            {/* Quick Action Button: Simulate Smart Irrigation */}\n            <button\n              onClick={handleSimulateIrrigation}\n              disabled={isSimulatingIrrigation}\n              className=\"w-full py-2 bg-[#141414] hover:bg-[#141414]/90 text-white font-bold font-mono uppercase text-[10px] flex items-center justify-center space-x-2 transition-all disabled:opacity-50\"\n            >\n              {isSimulatingIrrigation ? (\n                <>\n                  <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n                  <span>Triggering Drip Irrigation...</span>\n                </>\n              ) : (\n                <>\n                  <CloudRain className=\"w-3.5 h-3.5\" />\n                  <span>Trigger Drip Irrigation</span>\n                </>\n              )}\n            </button>\n          </div>\n\n          {/* College Project Architecture Quick Callout */}\n          <div className=\"bg-[#E4E3E0] border-2 border-[#141414] p-4 space-y-2\">\n            <h4 className=\"text-[10px] font-bold uppercase tracking-wider text-[#141414] flex items-center space-x-1.5 font-mono\">\n              <Sparkles className=\"w-3 h-3\" />\n              <span>Project Core</span>\n            </h4>\n            <p className=\"text-[10px] text-[#141414] leading-relaxed font-mono uppercase font-bold\">\n              This Digital Twin synchronizes physical IoT sensor streams with virtual crop state machines. The 6 key parameters drive real-time farm decision support.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "          return (\n            <div\n              key={param.id}\n              onClick={() => setActiveOverlay(param.id as any)}\n              className={`p-4 rounded-xl border transition-all cursor-pointer relative overflow-hidden ${\n                activeOverlay === param.id\n                  ? \'bg-emerald-50 border-emerald-500 shadow-sm\'\n                  : \'bg-white border-slate-100 hover:border-emerald-200 hover:shadow-sm\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"text-sm font-medium text-slate-600\">{param.name.replace(\' Detection\', \'\')}</span>\n                <div\n                  className=\"w-2.5 h-2.5 rounded-full\"\n                  style={{ backgroundColor: param.color }}\n                />\n              </div>\n              <div className=\"text-xl font-bold text-slate-900 tracking-tight\">{format}</div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Main Canvas & Live Controls Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Interactive Digital Twin Render Stage (8 Cols) */}\n        <div className=\"lg:col-span-8 bg-white rounded-2xl shadow-sm border border-slate-100 p-5 relative overflow-hidden\">\n          {/* Header Controls for Canvas */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3 mb-4 pb-4 border-b border-slate-100\">\n            <div className=\"flex items-center space-x-2\">\n              <Layers className=\"w-5 h-5 text-emerald-600\" />\n              <h2 className=\"text-lg font-bold text-slate-900\">\n                Twin Simulation Stage\n              </h2>\n              <span className=\"text-xs px-2 py-1 bg-slate-100 text-slate-700 rounded-md font-medium\">\n                {twinState.cropType} \342\200\242 Stage: {twinState.stage}\n              </span>\n            </div>\n\n            <div className=\"flex items-center space-x-2 text-sm\">\n              <span className=\"text-slate-500 font-medium\">Overlay:</span>\n              {([\'all\', \'height\', \'canopy\', \'disease\', \'ripeness\'] as const).map((mode) => (\n                <button\n                  key={mode}\n                  onClick={() => setActiveOverlay(mode)}\n                  className={`px-3 py-1.5 rounded-lg border transition-colors capitalize font-medium ${\n                    activeOverlay === mode\n                      ? \'bg-slate-900 text-white border-slate-900\'\n                      : \'bg-white text-slate-600 border-slate-200 hover:bg-slate-50\'\n                  }`}\n                >\n                  {mode}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Graphical Crop Field Visualization Stage */}\n          <div className=\"relative w-full h-[400px] bg-slate-50 rounded-xl border border-slate-100 overflow-hidden flex items-center justify-center\">\n            {/* Field Grid Pattern */}\n            <div \n              className=\"absolute inset-0 opacity-10 pointer-events-none\"\n              style={{\n                backgroundImage: `radial-gradient(#64748b 1px, transparent 1px)`,\n                backgroundSize: \'24px 24px\',\n              }}\n            />\n\n            {/* IoT Sensor Pulse Node */}\n            <div className=\"absolute top-4 left-4 flex items-center space-x-2 bg-white/90 backdrop-blur border border-slate-200 rounded-lg px-3 py-2 shadow-sm\">\n              <Radio className=\"w-4 h-4 text-emerald-500 animate-pulse\" />\n              <div>\n                <div className=\"font-bold text-slate-900 text-xs\">{twinState.sensors.id}</div>\n                <div className=\"text-[10px] text-slate-500 font-medium\">{twinState.sensors.name}</div>\n              </div>\n            </div>\n\n            {/* Health Index Meter Overlay */}\n            <div className=\"absolute top-4 right-4 bg-white/90 backdrop-blur rounded-lg border border-slate-200 p-3 shadow-sm text-right\">\n              <div className=\"text-xs text-slate-500 font-medium\">Twin Health Index</div>\n              <div className=\"text-2xl font-bold text-emerald-600\">{twinState.healthScore}%</div>\n            </div>\n\n            {/* Simulated Plants Row in Canvas */}\n            <div className=\"relative z-10 flex items-end justify-center space-x-8 w-full max-w-xl px-4\">\n              {[0, 1, 2, 3, 4].map((idx) => {\n                // Height calculation scaled for visualization\n                const plantHeightPx = Math.min(260, Math.max(60, twinState.plantHeightCm * 1.8));\n                const canopyWidthPx = Math.min(140, Math.max(50, twinState.canopyCoveragePercent * 1.4));\n                const ripenessColor = getRipenessColor(twinState.fruitRipenessPercent);\n\n                return (\n                  <div key={idx} className=\"flex flex-col items-center group relative\">\n                    {/* Plant Height Annotation */}\n                    {(activeOverlay === \'all\' || activeOverlay === \'height\') && idx === 2 && (\n                      <div className=\"absolute -top-10 bg-white shadow-md rounded-lg text-slate-900 px-2 py-1 text-xs font-bold animate-bounce z-20 border border-slate-100\">\n                        Height: {twinState.plantHeightCm.toFixed(1)} cm\n                      </div>\n                    )}\n\n                    {/* Disease Alert Highlight */}\n                    {(activeOverlay === \'all\' || activeOverlay === \'disease\') && twinState.diseaseRiskPercent > 12 && idx === 1 && (\n                      <div className=\"absolute -top-12 bg-red-50 border border-red-200 text-red-700 px-2 py-1 rounded-lg text-xs font-bold flex items-center space-x-1 animate-pulse z-20 shadow-sm\">\n                        <ShieldAlert className=\"w-3.5 h-3.5\" />\n                        <span>Spot Risk ({twinState.diseaseRiskPercent}%)</span>\n                      </div>\n                    )}\n\n                    {/* Plant SVG Structure */}\n                    <div \n                      className=\"relative flex items-end justify-center transition-all duration-500\"\n                      style={{ height: `${plantHeightPx}px` }}\n                    >\n                      {/* Main Stem */}\n                      <div className=\"w-3 bg-gradient-to-t from-emerald-800 to-emerald-500 rounded-full h-full shadow-inner\" />\n\n                      {/* Leaves Canopy Layer */}\n                      <div \n                        className=\"absolute bottom-1/3 rounded-full bg-emerald-500/90 shadow-lg backdrop-blur-sm transition-all duration-500 border border-emerald-400\"\n                        style={{\n                          width: `${canopyWidthPx}px`,\n                          height: `${canopyWidthPx * 0.7}px`,\n                          opacity: activeOverlay === \'disease\' && twinState.diseaseRiskPercent > 20 ? 0.6 : 0.9,\n                        }}\n                      />\n\n                      {/* Leaves Detail */}\n                      <div className=\"absolute top-1/4 -left-6 w-8 h-4 rounded-full bg-emerald-600 transform -rotate-12 shadow-sm\" />\n                      <div className=\"absolute top-1/4 -right-6 w-8 h-4 rounded-full bg-emerald-600 transform rotate-12 shadow-sm\" />\n                      <div className=\"absolute top-2/4 -left-8 w-10 h-5 rounded-full bg-emerald-500 transform -rotate-12 shadow-sm\" />\n                      <div className=\"absolute top-2/4 -right-8 w-10 h-5 rounded-full bg-emerald-500 transform rotate-12 shadow-sm\" />\n\n                      {/* Fruit/Grain Pods with Ripeness Indicator */}\n                      <div \n                        className=\"absolute top-1/6 w-5 h-5 rounded-full shadow-md transition-all duration-500 flex items-center justify-center border-2 border-white/50 z-10\"\n                        style={{ backgroundColor: ripenessColor }}\n                      >\n                        <div className=\"w-1.5 h-1.5 bg-white/60 rounded-full\" />\n                      </div>\n                    </div>\n\n                    {/* Ground Root Base & Soil Marker */}\n                    <div className=\"w-16 h-1.5 rounded-full bg-slate-800/20 mt-2 blur-[1px]\" />\n                  </div>\n                );\n              })}\n            </div>\n\n            {/* Bottom Parameter Legend bar on Canvas */}\n            <div className=\"absolute bottom-4 inset-x-4 bg-white/90 backdrop-blur rounded-xl border border-slate-200 p-3 flex flex-wrap items-center justify-between text-xs font-medium text-slate-600 shadow-sm\">\n              <div className=\"flex items-center space-x-6\">\n                <span className=\"flex items-center space-x-1.5\">\n                  <Ruler className=\"w-4 h-4 text-blue-500\" />\n                  <span>Height: {twinState.plantHeightCm.toFixed(1)}cm</span>\n                </span>\n                <span className=\"flex items-center space-x-1.5\">\n                  <Maximize className=\"w-4 h-4 text-emerald-500\" />\n                  <span>Canopy: {twinState.canopyCoveragePercent.toFixed(1)}%</span>\n                </span>\n                <span className=\"flex items-center space-x-1.5\">\n                  <Apple className=\"w-4 h-4 text-amber-500\" />\n                  <span>Ripeness: {twinState.fruitRipenessPercent.toFixed(1)}%</span>\n                </span>\n              </div>\n              <div className=\"font-bold text-purple-600\">\n                Yield Est: {twinState.estimatedYieldKgPerM2.toFixed(1)} kg/m\302\262\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Live Environmental Control & Sensor Suite (4 Cols) */}\n        <div className=\"lg:col-span-4 space-y-4\">\n          {/* Environment Actuator Card */}\n          <div className=\"bg-white rounded-2xl shadow-sm border border-slate-100 p-5 space-y-5\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <div className=\"flex items-center space-x-2\">\n                <Activity className=\"w-5 h-5 text-slate-700\" />\n                <h3 className=\"text-lg font-bold text-slate-900\">Climate Control</h3>\n              </div>\n              <span className=\"text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded-md font-medium\">\n                Interactive\n              </span>\n            </div>\n\n            {/* Temperature Slider */}\n            <div className=\"space-y-2 text-sm text-slate-700\">\n              <div className=\"flex justify-between font-medium\">\n                <span className=\"flex items-center space-x-1.5 text-orange-600\">\n                  <Thermometer className=\"w-4 h-4\" />\n                  <span>Air Temp</span>\n                </span>\n                <span className=\"font-bold text-slate-900\">{twinState.sensors.temperature}\302\260C</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"10\"\n                max=\"42\"\n                value={twinState.sensors.temperature}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, temperature: parseFloat(e.target.value) },\n                  })\n                }\n                className=\"w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-orange-500\"\n              />\n            </div>\n\n            {/* Humidity Slider */}\n            <div className=\"space-y-2 text-sm text-slate-700\">\n              <div className=\"flex justify-between font-medium\">\n                <span className=\"flex items-center space-x-1.5 text-blue-500\">\n                  <Droplets className=\"w-4 h-4\" />\n                  <span>Humidity</span>\n                </span>\n                <span className=\"font-bold text-slate-900\">{twinState.sensors.humidity}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"20\"\n                max=\"95\"\n                value={twinState.sensors.humidity}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, humidity: parseInt(e.target.value, 10) },\n                  })\n                }\n                className=\"w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-500\"\n              />\n            </div>\n\n            {/* Soil Moisture Slider */}\n            <div className=\"space-y-2 text-sm text-slate-700\">\n              <div className=\"flex justify-between font-medium\">\n                <span className=\"flex items-center space-x-1.5 text-cyan-500\">\n                  <CloudRain className=\"w-4 h-4\" />\n                  <span>Moisture</span>\n                </span>\n                <span className=\"font-bold text-slate-900\">{twinState.sensors.soilMoisture}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"10\"\n                max=\"90\"\n                value={twinState.sensors.soilMoisture}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, soilMoisture: parseInt(e.target.value, 10) },\n                  })\n                }\n                className=\"w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-cyan-500\"\n              />\n            </div>\n\n            {/* Quick Action Button: Simulate Smart Irrigation */}\n            <button\n              onClick={handleSimulateIrrigation}\n              disabled={isSimulatingIrrigation}\n              className=\"w-full py-2.5 mt-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl font-medium text-sm flex items-center justify-center space-x-2 transition-all disabled:opacity-70 shadow-sm\"\n            >\n              {isSimulatingIrrigation ? (\n                <>\n                  <Sparkles className=\"w-4 h-4 animate-spin\" />\n                  <span>Triggering Irrigation...</span>\n                </>\n              ) : (\n                <>\n                  <CloudRain className=\"w-4 h-4\" />\n                  <span>Trigger Drip Irrigation</span>\n                </>\n              )}\n            </button>\n          </div>\n\n          {/* College Project Architecture Quick Callout */}\n          <div className=\"bg-emerald-50 rounded-2xl border border-emerald-100 p-5 space-y-2\">\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-emerald-800 flex items-center space-x-2\">\n              <Sparkles className=\"w-4 h-4\" />\n              <span>Project Core</span>\n            </h4>\n            <p className=\"text-sm text-emerald-700 leading-relaxed font-medium\">\n              This Digital Twin synchronizes physical IoT sensor streams with virtual crop state machines. The parameters drive real-time farm decision support.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
