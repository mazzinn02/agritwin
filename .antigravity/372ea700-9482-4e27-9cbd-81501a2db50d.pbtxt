    instruction: "Apply High Density style to PresentationSlidesExport.tsx"
    replacement_infos {
      original_chunk {
        target_content: "    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <Presentation className=\"w-5 h-5 text-blue-400\" />\n            <h2 className=\"text-lg font-bold text-slate-100\">Google Slides Presentation Deck Generator</h2>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-1 max-w-2xl\">\n            Export a complete, professional college project presentation directly to Google Slides to present your application, digital twin blueprint, and implementation plan to clients and faculty.\n          </p>\n        </div>\n\n        <div className=\"px-3 py-1.5 bg-blue-950/40 border border-blue-500/30 rounded-lg text-xs font-semibold text-blue-300 flex items-center space-x-1.5\">\n          <Sparkles className=\"w-4 h-4 text-blue-400\" />\n          <span>Google Workspace Integration</span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Project & Team Configuration Form (5 Cols) */}\n        <div className=\"lg:col-span-5 bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-4\">\n          <h3 className=\"text-sm font-semibold text-slate-200 flex items-center space-x-2\">\n            <GraduationCap className=\"w-4 h-4 text-emerald-400\" />\n            <span>Project Details & Team Info</span>\n          </h3>\n\n          {/* Project Title */}\n          <div className=\"space-y-1\">\n            <label className=\"text-xs text-slate-400 font-medium\">Presentation Title:</label>\n            <input\n              type=\"text\"\n              value={config.projectTitle}\n              onChange={(e) => setConfig({ ...config, projectTitle: e.target.value })}\n              className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-emerald-500\"\n            />\n          </div>\n\n          {/* Student Role */}\n          <div className=\"space-y-1\">\n            <label className=\"text-xs text-slate-400 font-medium\">Your Name & Role (Lead Developer):</label>\n            <input\n              type=\"text\"\n              value={config.studentName}\n              onChange={(e) => setConfig({ ...config, studentName: e.target.value })}\n              className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-emerald-500\"\n            />\n          </div>\n\n          {/* College Name */}\n          <div className=\"space-y-1\">\n            <label className=\"text-xs text-slate-400 font-medium\">College / University Name:</label>\n            <input\n              type=\"text\"\n              value={config.collegeName}\n              onChange={(e) => setConfig({ ...config, collegeName: e.target.value })}\n              className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-emerald-500\"\n            />\n          </div>\n\n          {/* Client Name */}\n          <div className=\"space-y-1\">\n            <label className=\"text-xs text-slate-400 font-medium\">Target Client / Evaluator Name:</label>\n            <input\n              type=\"text\"\n              value={config.clientName}\n              onChange={(e) => setConfig({ ...config, clientName: e.target.value })}\n              className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-emerald-500\"\n            />\n          </div>\n\n          {/* Export Action Button */}\n          <div className=\"pt-3 border-t border-slate-800 space-y-2\">\n            {!accessToken ? (\n              <button\n                onClick={handleRequestOAuthToken}\n                className=\"w-full py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-2 shadow-lg shadow-blue-500/20 transition-all\"\n              >\n                <Presentation className=\"w-4 h-4\" />\n                <span>Authorize & Connect Google Slides</span>\n              </button>\n            ) : (\n              <button\n                onClick={handleCreateGoogleSlides}\n                disabled={isExporting}\n                className=\"w-full py-3 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-slate-950 font-bold rounded-xl text-xs flex items-center justify-center space-x-2 shadow-lg shadow-emerald-500/20 transition-all disabled:opacity-50\"\n              >\n                {isExporting ? (\n                  <>\n                    <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                    <span>Generating Google Slides Presentation Deck...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4\" />\n                    <span>Generate Presentation Deck in Google Slides</span>\n                  </>\n                )}\n              </button>\n            )}\n\n            {presentationUrl && (\n              <a\n                href={presentationUrl}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"w-full py-2.5 px-4 bg-emerald-950 border border-emerald-500/50 text-emerald-300 font-semibold rounded-xl text-xs flex items-center justify-center space-x-2 hover:bg-emerald-900/50 transition-all\"\n              >\n                <ExternalLink className=\"w-4 h-4\" />\n                <span>Open Created Presentation in Google Slides</span>\n              </a>\n            )}\n\n            {errorMessage && (\n              <div className=\"p-3 bg-red-950/50 border border-red-500/50 text-red-300 rounded-xl text-xs flex items-center space-x-2\">\n                <AlertCircle className=\"w-4 h-4 text-red-400 shrink-0\" />\n                <span>{errorMessage}</span>\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Presentation Slide Outline Preview (7 Cols) */}\n        <div className=\"lg:col-span-7 bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-4\">\n          <h3 className=\"text-sm font-semibold text-slate-200 flex items-center space-x-2\">\n            <FileText className=\"w-4 h-4 text-blue-400\" />\n            <span>8-Slide Presentation Outline Preview</span>\n          </h3>\n\n          <div className=\"space-y-3 max-h-[500px] overflow-y-auto pr-2 scrollbar-thin\">\n            {/* Slide 1 */}\n            <div className=\"p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1\">\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-blue-400\">Slide 1: Title & College Introduction</span>\n                <span className=\"text-[10px] text-slate-500 font-mono\">Title Layout</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">\"{config.projectTitle}\"</p>\n              <span className=\"text-[11px] text-slate-400 block\">Lead Developer: {config.studentName} | {config.collegeName}</span>\n            </div>\n\n            {/* Slide 2 */}\n            <div className=\"p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1\">\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-blue-400\">Slide 2: Problem Statement & Digital Twin Vision</span>\n                <span className=\"text-[10px] text-slate-500 font-mono\">Concept Layout</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">Why traditional farming needs real-time physical-to-virtual digital twin synchronization.</p>\n            </div>\n\n            {/* Slide 3 */}\n            <div className=\"p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1\">\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-blue-400\">Slide 3: The 6 Core Parameters Architecture</span>\n                <span className=\"text-[10px] text-slate-500 font-mono\">Figure 1 Blueprint</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">Detailed breakdown of Height, Canopy, Growth, Disease, Ripeness, and Yield metrics.</p>\n            </div>\n\n            {/* Slide 4 */}\n            <div className=\"p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1\">\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-blue-400\">Slide 4: Hardware & IoT Edge Sensing Deployment</span>\n                <span className=\"text-[10px] text-slate-500 font-mono\">Hardware Layer</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">ESP32 microcontrollers, LoRaWAN wireless mesh, and stereo optical pods.</p>\n            </div>\n\n            {/* Slide 5 */}\n            <div className=\"p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1\">\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-blue-400\">Slide 5: Software & Gemini AI Vision Pipeline</span>\n                <span className=\"text-[10px] text-slate-500 font-mono\">AI Architecture</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">Server-side Express + Gemini 2.5 Flash computer vision scan for zero-shot plant diagnosis.</p>\n            </div>\n\n            {/* Slide 6 */}\n            <div className=\"p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1\">\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-blue-400\">Slide 6: Live Web Application & Twin Simulation</span>\n                <span className=\"text-[10px] text-slate-500 font-mono\">App Demo</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">Interactive web application capabilities, environmental climate actuators, and yield forecasting.</p>\n            </div>\n\n            {/* Slide 7 */}\n            <div className=\"p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1\">\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-blue-400\">Slide 7: Client Value & ROI Impact</span>\n                <span className=\"text-[10px] text-slate-500 font-mono\">Client Outcomes</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">Prepared for: {config.clientName}. Reduced crop loss by 35% and increased harvest predictability.</p>\n            </div>\n\n            {/* Slide 8 */}\n            <div className=\"p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-1\">\n              <div className=\"flex items-center justify-between text-xs\">\n                <span className=\"font-bold text-blue-400\">Slide 8: Summary & Q&A</span>\n                <span className=\"text-[10px] text-slate-500 font-mono\">Conclusion</span>\n              </div>\n              <p className=\"text-xs text-slate-300\">Summary of implementation milestones and live demonstration.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>"
        replacement_content: "    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-white border-2 border-[#141414] p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 uppercase font-mono\">\n        <div>\n          <div className=\"flex items-center space-x-2 border-b-2 border-[#141414] pb-2 mb-2 inline-flex pr-4\">\n            <Presentation className=\"w-5 h-5 text-[#141414]\" />\n            <h2 className=\"text-base font-bold text-[#141414]\">Google Slides Presentation Deck Generator</h2>\n          </div>\n          <p className=\"text-[10px] text-[#141414]/80 font-bold max-w-2xl\">\n            Export a complete, professional college project presentation directly to Google Slides to present your application, digital twin blueprint, and implementation plan to clients and faculty.\n          </p>\n        </div>\n\n        <div className=\"px-3 py-1.5 bg-[#141414] text-white border-2 border-[#141414] text-[10px] font-bold flex items-center space-x-1.5 whitespace-nowrap\">\n          <Sparkles className=\"w-3 h-3 text-white\" />\n          <span>Google Workspace Integration</span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 uppercase font-mono\">\n        {/* Project & Team Configuration Form (5 Cols) */}\n        <div className=\"lg:col-span-5 bg-white border-2 border-[#141414] p-4 space-y-4\">\n          <h3 className=\"text-sm font-bold text-[#141414] flex items-center space-x-2 border-b-2 border-[#141414] pb-2\">\n            <GraduationCap className=\"w-4 h-4 text-[#141414]\" />\n            <span>Project Details & Team Info</span>\n          </h3>\n\n          {/* Project Title */}\n          <div className=\"space-y-1\">\n            <label className=\"text-[10px] text-[#141414] font-bold\">Presentation Title:</label>\n            <input\n              type=\"text\"\n              value={config.projectTitle}\n              onChange={(e) => setConfig({ ...config, projectTitle: e.target.value })}\n              className=\"w-full bg-[#F9F9F9] border-2 border-[#141414] px-2 py-1.5 text-xs text-[#141414] font-bold focus:outline-none focus:bg-white\"\n            />\n          </div>\n\n          {/* Student Role */}\n          <div className=\"space-y-1\">\n            <label className=\"text-[10px] text-[#141414] font-bold\">Your Name & Role (Lead Developer):</label>\n            <input\n              type=\"text\"\n              value={config.studentName}\n              onChange={(e) => setConfig({ ...config, studentName: e.target.value })}\n              className=\"w-full bg-[#F9F9F9] border-2 border-[#141414] px-2 py-1.5 text-xs text-[#141414] font-bold focus:outline-none focus:bg-white\"\n            />\n          </div>\n\n          {/* College Name */}\n          <div className=\"space-y-1\">\n            <label className=\"text-[10px] text-[#141414] font-bold\">College / University Name:</label>\n            <input\n              type=\"text\"\n              value={config.collegeName}\n              onChange={(e) => setConfig({ ...config, collegeName: e.target.value })}\n              className=\"w-full bg-[#F9F9F9] border-2 border-[#141414] px-2 py-1.5 text-xs text-[#141414] font-bold focus:outline-none focus:bg-white\"\n            />\n          </div>\n\n          {/* Client Name */}\n          <div className=\"space-y-1\">\n            <label className=\"text-[10px] text-[#141414] font-bold\">Target Client / Evaluator Name:</label>\n            <input\n              type=\"text\"\n              value={config.clientName}\n              onChange={(e) => setConfig({ ...config, clientName: e.target.value })}\n              className=\"w-full bg-[#F9F9F9] border-2 border-[#141414] px-2 py-1.5 text-xs text-[#141414] font-bold focus:outline-none focus:bg-white\"\n            />\n          </div>\n\n          {/* Export Action Button */}\n          <div className=\"pt-4 border-t-2 border-[#141414] space-y-2\">\n            {!accessToken ? (\n              <button\n                onClick={handleRequestOAuthToken}\n                className=\"w-full py-2 bg-[#141414] border-2 border-[#141414] text-white hover:bg-white hover:text-[#141414] font-bold text-[10px] flex items-center justify-center space-x-2 transition-all\"\n              >\n                <Presentation className=\"w-3.5 h-3.5\" />\n                <span>Authorize & Connect Google Slides</span>\n              </button>\n            ) : (\n              <button\n                onClick={handleCreateGoogleSlides}\n                disabled={isExporting}\n                className=\"w-full py-2 bg-white border-2 border-[#141414] hover:bg-[#141414] hover:text-white text-[#141414] font-bold text-[10px] flex items-center justify-center space-x-2 transition-all disabled:opacity-50\"\n              >\n                {isExporting ? (\n                  <>\n                    <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                    <span>Generating Google Slides...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-3.5 h-3.5\" />\n                    <span>Generate Presentation Deck</span>\n                  </>\n                )}\n              </button>\n            )}\n\n            {presentationUrl && (\n              <a\n                href={presentationUrl}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"w-full py-2 px-4 bg-[#E4E3E0] border-2 border-[#141414] text-[#141414] font-bold text-[10px] flex items-center justify-center space-x-2 hover:bg-white transition-all\"\n              >\n                <ExternalLink className=\"w-3.5 h-3.5\" />\n                <span>Open Created Presentation</span>\n              </a>\n            )}\n\n            {errorMessage && (\n              <div className=\"p-2 bg-red-100 border-2 border-red-600 text-red-600 font-bold text-[10px] flex items-center space-x-2\">\n                <AlertCircle className=\"w-3.5 h-3.5 shrink-0\" />\n                <span>{errorMessage}</span>\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Presentation Slide Outline Preview (7 Cols) */}\n        <div className=\"lg:col-span-7 bg-white border-2 border-[#141414] p-4 space-y-4\">\n          <h3 className=\"text-sm font-bold text-[#141414] flex items-center space-x-2 border-b-2 border-[#141414] pb-2\">\n            <FileText className=\"w-4 h-4 text-[#141414]\" />\n            <span>8-Slide Presentation Outline Preview</span>\n          </h3>\n\n          <div className=\"space-y-3 max-h-[500px] overflow-y-auto pr-2 scrollbar-thin\">\n            {/* Slide 1 */}\n            <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n              <div className=\"flex items-center justify-between text-[10px] border-b border-[#141414]/30 pb-1 mb-1\">\n                <span className=\"font-bold text-[#141414]\">Slide 1: Title & College Intro</span>\n                <span className=\"text-[8px] text-[#141414]/70 font-bold\">Title Layout</span>\n              </div>\n              <p className=\"text-[11px] font-bold text-[#141414]\">\"{config.projectTitle}\"</p>\n              <span className=\"text-[9px] text-[#141414]/80 block font-bold\">Lead Developer: {config.studentName} | {config.collegeName}</span>\n            </div>\n\n            {/* Slide 2 */}\n            <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n              <div className=\"flex items-center justify-between text-[10px] border-b border-[#141414]/30 pb-1 mb-1\">\n                <span className=\"font-bold text-[#141414]\">Slide 2: Problem & Digital Twin Vision</span>\n                <span className=\"text-[8px] text-[#141414]/70 font-bold\">Concept Layout</span>\n              </div>\n              <p className=\"text-[10px] text-[#141414]/80 font-bold\">Why traditional farming needs real-time physical-to-virtual digital twin synchronization.</p>\n            </div>\n\n            {/* Slide 3 */}\n            <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n              <div className=\"flex items-center justify-between text-[10px] border-b border-[#141414]/30 pb-1 mb-1\">\n                <span className=\"font-bold text-[#141414]\">Slide 3: 6 Core Parameters Architecture</span>\n                <span className=\"text-[8px] text-[#141414]/70 font-bold\">Figure 1 Blueprint</span>\n              </div>\n              <p className=\"text-[10px] text-[#141414]/80 font-bold\">Detailed breakdown of Height, Canopy, Growth, Disease, Ripeness, and Yield metrics.</p>\n            </div>\n\n            {/* Slide 4 */}\n            <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n              <div className=\"flex items-center justify-between text-[10px] border-b border-[#141414]/30 pb-1 mb-1\">\n                <span className=\"font-bold text-[#141414]\">Slide 4: Hardware & IoT Edge Deployment</span>\n                <span className=\"text-[8px] text-[#141414]/70 font-bold\">Hardware Layer</span>\n              </div>\n              <p className=\"text-[10px] text-[#141414]/80 font-bold\">ESP32 microcontrollers, LoRaWAN wireless mesh, and stereo optical pods.</p>\n            </div>\n\n            {/* Slide 5 */}\n            <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n              <div className=\"flex items-center justify-between text-[10px] border-b border-[#141414]/30 pb-1 mb-1\">\n                <span className=\"font-bold text-[#141414]\">Slide 5: Software & Gemini AI Vision</span>\n                <span className=\"text-[8px] text-[#141414]/70 font-bold\">AI Architecture</span>\n              </div>\n              <p className=\"text-[10px] text-[#141414]/80 font-bold\">Server-side Express + Gemini 2.5 Flash computer vision scan for zero-shot plant diagnosis.</p>\n            </div>\n\n            {/* Slide 6 */}\n            <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n              <div className=\"flex items-center justify-between text-[10px] border-b border-[#141414]/30 pb-1 mb-1\">\n                <span className=\"font-bold text-[#141414]\">Slide 6: Live Web App & Twin Sim</span>\n                <span className=\"text-[8px] text-[#141414]/70 font-bold\">App Demo</span>\n              </div>\n              <p className=\"text-[10px] text-[#141414]/80 font-bold\">Interactive web application capabilities, environmental climate actuators, and yield forecasting.</p>\n            </div>\n\n            {/* Slide 7 */}\n            <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n              <div className=\"flex items-center justify-between text-[10px] border-b border-[#141414]/30 pb-1 mb-1\">\n                <span className=\"font-bold text-[#141414]\">Slide 7: Client Value & ROI Impact</span>\n                <span className=\"text-[8px] text-[#141414]/70 font-bold\">Client Outcomes</span>\n              </div>\n              <p className=\"text-[10px] text-[#141414]/80 font-bold\">Prepared for: {config.clientName}. Reduced crop loss by 35% and increased harvest predictability.</p>\n            </div>\n\n            {/* Slide 8 */}\n            <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n              <div className=\"flex items-center justify-between text-[10px] border-b border-[#141414]/30 pb-1 mb-1\">\n                <span className=\"font-bold text-[#141414]\">Slide 8: Summary & Q&A</span>\n                <span className=\"text-[8px] text-[#141414]/70 font-bold\">Conclusion</span>\n              </div>\n              <p className=\"text-[10px] text-[#141414]/80 font-bold\">Summary of implementation milestones and live demonstration.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>"
      }
      num_matches: 1
    }
  }
}
