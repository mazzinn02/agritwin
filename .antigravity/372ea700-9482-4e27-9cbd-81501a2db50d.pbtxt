      target_content: "    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <FileCode2 className=\"w-5 h-5 text-amber-400\" />\n            <h2 className=\"text-lg font-bold text-slate-100\">College Project Implementation Blueprint</h2>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-1 max-w-2xl\">\n            Detailed technical hardware and software architecture showing how the physical farm environment connects digitally to the web application.\n          </p>\n        </div>\n\n        <div className=\"px-3 py-1.5 bg-amber-950/40 border border-amber-500/30 rounded-lg text-xs font-semibold text-amber-300\">\n          5-Stage Digital Architecture\n        </div>\n      </div>\n\n      {/* Interactive 5-Stage Data Flow Pipeline */}\n      <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl space-y-6\">\n        <h3 className=\"text-sm font-bold text-slate-200 flex items-center space-x-2\">\n          <Layers className=\"w-4 h-4 text-emerald-400\" />\n          <span>Physical-to-Digital End-to-End Pipeline</span>\n        </h3>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-5 gap-4 relative\">\n          {SYSTEM_BLUEPRINT_STAGES.map((stage, idx) => (\n            <div\n              key={stage.step}\n              className=\"bg-slate-950 rounded-xl border border-slate-800 p-4 relative flex flex-col justify-between hover:border-slate-700 transition-all space-y-3\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className=\"w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-bold flex items-center justify-center\">\n                    {stage.step}\n                  </span>\n                  <span className=\"text-[10px] text-slate-400 font-mono\">{stage.subtitle}</span>\n                </div>\n\n                <h4 className=\"text-xs font-bold text-slate-100\">{stage.title}</h4>\n                <p className=\"text-[11px] text-slate-400 mt-1 leading-relaxed\">{stage.description}</p>\n              </div>\n\n              <div className=\"pt-2 border-t border-slate-800/80\">\n                <span className=\"text-[10px] text-slate-400 font-medium block mb-1\">Key Tech:</span>\n                <div className=\"flex flex-wrap gap-1\">\n                  {stage.tech.map((t, tidx) => (\n                    <span\n                      key={tidx}\n                      className=\"px-1.5 py-0.5 bg-slate-900 text-[9px] font-mono text-slate-300 rounded border border-slate-800\"\n                    >\n                      {t}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Technical Component Roles Table */}\n      <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl space-y-4\">\n        <h3 className=\"text-sm font-bold text-slate-200 flex items-center space-x-2\">\n          <Cpu className=\"w-4 h-4 text-cyan-400\" />\n          <span>System Component Technical Roles</span>\n        </h3>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n          {TECHNICAL_COMPONENTS.map((comp) => (\n            <div key={comp.id} className=\"p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-[10px] font-mono text-cyan-400 bg-cyan-950/60 px-2 py-0.5 rounded border border-cyan-500/30 uppercase\">\n                  {comp.layer}\n                </span>\n                <Sparkles className=\"w-3.5 h-3.5 text-slate-500\" />\n              </div>\n\n              <div>\n                <h4 className=\"text-xs font-bold text-slate-200\">{comp.title}</h4>\n                <p className=\"text-[11px] text-slate-400 mt-1\">{comp.description}</p>\n              </div>\n\n              <div className=\"pt-2 border-t border-slate-800/80\">\n                <span className=\"text-[10px] text-slate-400 font-semibold block mb-1\">Role in Project:</span>\n                <p className=\"text-[11px] text-emerald-300 font-medium\">{comp.roleInProject}</p>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>"
      replacement_content: "    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-white border-2 border-[#141414] p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 uppercase font-mono\">\n        <div>\n          <div className=\"flex items-center space-x-2 border-b-2 border-[#141414] pb-2 mb-2 inline-flex pr-4\">\n            <FileCode2 className=\"w-5 h-5 text-[#141414]\" />\n            <h2 className=\"text-base font-bold text-[#141414]\">College Project Implementation Blueprint</h2>\n          </div>\n          <p className=\"text-[10px] text-[#141414]/80 font-bold max-w-2xl\">\n            Detailed technical hardware and software architecture showing how the physical farm environment connects digitally to the web application.\n          </p>\n        </div>\n\n        <div className=\"px-3 py-1.5 bg-[#141414] text-white border-2 border-[#141414] text-[10px] font-bold whitespace-nowrap\">\n          5-Stage Digital Architecture\n        </div>\n      </div>\n\n      {/* Interactive 5-Stage Data Flow Pipeline */}\n      <div className=\"bg-white border-2 border-[#141414] p-4 space-y-6 uppercase font-mono\">\n        <h3 className=\"text-sm font-bold text-[#141414] flex items-center space-x-2 border-b-2 border-[#141414] pb-2\">\n          <Layers className=\"w-4 h-4 text-[#141414]\" />\n          <span>Physical-to-Digital End-to-End Pipeline</span>\n        </h3>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-5 gap-4 relative\">\n          {SYSTEM_BLUEPRINT_STAGES.map((stage, idx) => (\n            <div\n              key={stage.step}\n              className=\"bg-[#E4E3E0] border-2 border-[#141414] p-3 relative flex flex-col justify-between hover:bg-white transition-all space-y-3 group\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-2 pb-2 border-b-2 border-[#141414]\">\n                  <span className=\"w-5 h-5 bg-[#141414] text-white text-[10px] font-bold flex items-center justify-center\">\n                    {stage.step}\n                  </span>\n                  <span className=\"text-[8px] text-[#141414] font-bold truncate ml-2\">{stage.subtitle}</span>\n                </div>\n\n                <h4 className=\"text-xs font-bold text-[#141414]\">{stage.title}</h4>\n                <p className=\"text-[9px] text-[#141414]/80 mt-1 leading-relaxed font-bold\">{stage.description}</p>\n              </div>\n\n              <div className=\"pt-2 border-t-2 border-[#141414]\">\n                <span className=\"text-[8px] text-[#141414] font-bold block mb-1\">Key Tech:</span>\n                <div className=\"flex flex-wrap gap-1\">\n                  {stage.tech.map((t, tidx) => (\n                    <span\n                      key={tidx}\n                      className=\"px-1 py-0.5 bg-white text-[8px] font-bold text-[#141414] border border-[#141414]\"\n                    >\n                      {t}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Technical Component Roles Table */}\n      <div className=\"bg-white border-2 border-[#141414] p-4 space-y-4 uppercase font-mono\">\n        <h3 className=\"text-sm font-bold text-[#141414] flex items-center space-x-2 border-b-2 border-[#141414] pb-2\">\n          <Cpu className=\"w-4 h-4 text-[#141414]\" />\n          <span>System Component Technical Roles</span>\n        </h3>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n          {TECHNICAL_COMPONENTS.map((comp) => (\n            <div key={comp.id} className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-3 hover:bg-white transition-colors\">\n              <div className=\"flex items-center justify-between pb-2 border-b-2 border-[#141414]\">\n                <span className=\"text-[9px] font-bold text-white bg-[#141414] px-1.5 py-0.5\">\n                  {comp.layer}\n                </span>\n                <Sparkles className=\"w-3.5 h-3.5 text-[#141414]\" />\n              </div>\n\n              <div>\n                <h4 className=\"text-[11px] font-bold text-[#141414]\">{comp.title}</h4>\n                <p className=\"text-[9px] text-[#141414]/80 mt-1 font-bold\">{comp.description}</p>\n              </div>\n\n              <div className=\"pt-2 border-t-2 border-[#141414]\">\n                <span className=\"text-[8px] text-[#141414] font-bold block mb-1\">Role in Project:</span>\n                <p className=\"text-[10px] text-[#141414] font-bold\">{comp.roleInProject}</p>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>"
