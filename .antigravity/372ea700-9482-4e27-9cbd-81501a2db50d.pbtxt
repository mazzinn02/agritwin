pi/weather:\", err);\n      return res.status(500).json({\n        error: \"Failed to fetch weather data using Gemini AI.\",\n        details: err?.message || String(err),\n      });\n    }\n  });\n\n  // Vite middleware in dev mode vs static serve in prod"
