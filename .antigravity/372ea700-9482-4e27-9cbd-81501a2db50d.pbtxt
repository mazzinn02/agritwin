        target_content: "    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <HelpCircle className=\"w-5 h-5 text-cyan-400\" />\n            <h2 className=\"text-lg font-bold text-slate-100\">Client Demonstration Guide - How It Works</h2>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-1 max-w-2xl\">\n            A step-by-step breakdown explaining to clients, professors, and project evaluators how the physical farm links digitally to this web application.\n          </p>\n        </div>\n\n        <div className=\"px-3 py-1.5 bg-cyan-950/40 border border-cyan-500/30 rounded-lg text-xs font-semibold text-cyan-300\">\n          5-Step Client Workflow\n        </div>\n      </div>\n\n      {/* Vertical Step-by-Step Flow */}\n      <div className=\"space-y-4\">\n        {WORKFLOW_STEPS.map((s, idx) => {\n          const IconComp = s.icon;\n          return (\n            <div\n              key={s.step}\n              className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl hover:border-slate-700 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-4\"\n            >\n              <div className=\"flex items-start space-x-4\">\n                <div className=\"w-12 h-12 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-center shrink-0\">\n                  <span className=\"text-sm font-bold text-emerald-400 font-mono\">{s.step}</span>\n                </div>\n\n                <div>\n                  <div className=\"flex items-center space-x-2\">\n                    <h3 className=\"text-sm font-bold text-slate-100\">{s.title}</h3>\n                    <span className=\"text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded border border-slate-700\">\n                      {s.badge}\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-slate-400 mt-1 max-w-2xl leading-relaxed\">{s.description}</p>\n                </div>\n              </div>\n\n              <div className=\"p-3 bg-slate-950 rounded-xl border border-slate-800 shrink-0 self-stretch md:self-auto flex items-center justify-center\">\n                <IconComp className=\"w-6 h-6 text-emerald-400\" />\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* College Project Role Summary */}\n      <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl space-y-3\">\n        <h3 className=\"text-sm font-bold text-slate-200 flex items-center space-x-2\">\n          <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n          <span>Role in College Project: Web Application & Digital Twin Lead</span>\n        </h3>\n        <p className=\"text-xs text-slate-300 leading-relaxed\">\n          In this college group project, your role focuses on creating the full application and web application interface that implements the 6-parameter blueprint digitally. It brings hardware telemetry to life, integrates Gemini AI vision, models biophysical plant growth, and provides one-click Google Slides presentation export for clients.\n        </p>\n      </div>\n    </div>"
        replacement_content: "    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-white border-2 border-[#141414] p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 uppercase font-mono\">\n        <div>\n          <div className=\"flex items-center space-x-2 border-b-2 border-[#141414] pb-2 mb-2 inline-flex pr-4\">\n            <HelpCircle className=\"w-5 h-5 text-[#141414]\" />\n            <h2 className=\"text-base font-bold text-[#141414]\">Client Demonstration Guide - How It Works</h2>\n          </div>\n          <p className=\"text-[10px] text-[#141414]/80 font-bold max-w-2xl\">\n            A step-by-step breakdown explaining to clients, professors, and project evaluators how the physical farm links digitally to this web application.\n          </p>\n        </div>\n\n        <div className=\"px-3 py-1.5 bg-[#141414] text-white border-2 border-[#141414] text-[10px] font-bold whitespace-nowrap\">\n          5-Step Client Workflow\n        </div>\n      </div>\n\n      {/* Vertical Step-by-Step Flow */}\n      <div className=\"space-y-4 uppercase font-mono\">\n        {WORKFLOW_STEPS.map((s, idx) => {\n          const IconComp = s.icon;\n          return (\n            <div\n              key={s.step}\n              className=\"bg-white border-2 border-[#141414] p-4 hover:bg-[#F9F9F9] transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-4\"\n            >\n              <div className=\"flex items-start space-x-4\">\n                <div className=\"w-12 h-12 bg-[#141414] text-white flex items-center justify-center shrink-0\">\n                  <span className=\"text-sm font-bold\">{s.step}</span>\n                </div>\n\n                <div>\n                  <div className=\"flex flex-wrap items-center gap-2 mb-1\">\n                    <h3 className=\"text-sm font-bold text-[#141414]\">{s.title}</h3>\n                    <span className=\"text-[8px] bg-[#