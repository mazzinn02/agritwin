        }
        lines {
          text: "  // Generate 12 time points representing growth cycle progression up to current day"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const generateGrowthHistory = () => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const points = [];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const totalDays = twinState.currentDay;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const step = Math.max(1, Math.floor(totalDays / 12));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    for (let day = 1; day <= totalDays; day += step) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const progressRatio = day / 90;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Exponential growth curve for plant height"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const height = Math.min(twinState.plantHeightCm, (Math.pow(progressRatio, 1.3) * twinState.plantHeightCm * 1.1) + 5);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // S-curve for canopy"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const canopy = Math.min(100, (1 / (1 + Math.exp(-6 * (progressRatio - 0.4)))) * twinState.canopyCoveragePercent * 1.05);"
