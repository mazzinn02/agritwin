    instruction: "Apply High Density style to Header.tsx"
    replacement_infos {
      original_chunk {
        target_content: "    <header className=\"bg-slate-900 border-b border-slate-800 text-slate-100 sticky top-0 z-50\">\n      {/* Top Banner */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Logo & Title */}\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center shadow-lg shadow-emerald-500/20 ring-1 ring-emerald-400/30\">\n              <Sprout className=\"w-6 h-6 text-slate-950 font-bold\" />\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <h1 className=\"text-lg font-bold tracking-tight text-white\">AgriTwin</h1>\n                <span className=\"px-2 py-0.5 text-xs font-semibold rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30\">\n                  College Project Blueprint\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400\">Digital Twin System for Smart Agriculture</p>\n            </div>\n          </div>\n\n          {/* Quick Controls: Crop & Time Slider */}\n          <div className=\"hidden lg:flex items-center space-x-6\">\n            {/* Crop Select */}\n            <div className=\"flex items-center space-x-2 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700/60\">\n              <Sprout className=\"w-4 h-4 text-emerald-400\" />\n              <span className=\"text-xs font-medium text-slate-400\">Crop:</span>\n              <select\n                value={twinState.cropType}\n                onChange={(e) => {\n                  const preset = CROP_PRESETS[e.target.value];\n                  if (preset) onUpdateCrop(preset);\n                }}\n                className=\"bg-transparent text-xs font-semibold text-slate-200 focus:outline-none cursor-pointer\"\n              >\n                {Object.keys(CROP_PRESETS).map((crop) => (\n                  <option key={crop} value={crop} className=\"bg-slate-900 text-slate-200\">\n                    {crop}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Day Scrubber */}\n            <div className=\"flex items-center space-x-3 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700/60\">\n              <div className=\"flex items-center space-x-1 text-xs text-slate-300 font-medium\">\n                <Calendar className=\"w-3.5 h-3.5 text-cyan-400\" />\n                <span>Day {twinState.currentDay} / 90</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"1\"\n                max=\"90\"\n                value={twinState.currentDay}\n                onChange={(e) => onDayChange(parseInt(e.target.value, 10))}\n                className=\"w-24 h-1.5 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500\"\n              />\n            </div>\n\n            {/* IoT Sync Status */}\n            <div className=\"flex items-center space-x-2 bg-emerald-950/50 border border-emerald-500/30 px-3 py-1.5 rounded-lg text-emerald-400 text-xs font-medium\">\n              <span className=\"relative flex h-2 w-2\">\n                <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n                <span className=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-500\"></span>\n              </span>\n              <Wifi className=\"w-3.5 h-3.5\" />\n              <span>IoT Telemetry Synced</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Navigation Tabs */}\n        <div className=\"flex space-x-1 overflow-x-auto pb-2 scrollbar-none border-t border-slate-800/80 pt-2\">\n          <button\n            onClick={() => onSelectView(\'twin\')}\n            className={`flex items-center space-x-2 px-3.5 py-2 rounded-lg text-xs font-medium transition-all whitespace-nowrap ${\n              currentView === \'twin\'\n                ? \'bg-emerald-500 text-slate-950 font-semibold shadow-md shadow-emerald-500/20\'\n                : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n            }`}\n          >\n            <Sliders className=\"w-4 h-4\" />\n            <span>Digital Twin Canvas</span>\n          </button>\n\n          <button\n            onClick={() => onSelectView(\'analytics\')}\n            className={`flex items-center space-x-2 px-3.5 py-2 rounded-lg text-xs font-medium transition-all whitespace-nowrap ${\n              currentView === \'analytics\'\n                ? \'bg-emerald-500 text-slate-950 font-semibold shadow-md shadow-emerald-500/20\'\n                : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n            }`}\n          >\n            <BarChart3 className=\"w-4 h-4\" />\n            <span>6-Parameter Analytics</span>\n          </button>\n\n          <button\n            onClick={() => onSelectView(\'scanner\')}\n            className={`flex items-center space-x-2 px-3.5 py-2 rounded-lg text-xs font-medium transition-all whitespace-nowrap ${\n              currentView === \'scanner\'\n                ? \'bg-emerald-500 text-slate-950 font-semibold shadow-md shadow-emerald-500/20\'\n                : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n            }`}\n          >\n            <Camera className=\"w-4 h-4 text-purple-400\" />\n            <span>AI Plant Vision Scanner</span>\n          </button>\n\n          <button\n            onClick={() => onSelectView(\'blueprint\')}\n            className={`flex items-center space-x-2 px-3.5 py-2 rounded-lg text-xs font-medium transition-all whitespace-nowrap ${\n              currentView === \'blueprint\'\n                ? \'bg-emerald-500 text-slate-950 font-semibold shadow-md s