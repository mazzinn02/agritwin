r\"\n              >\n                {Object.keys(CROP_PRESETS).map((crop) => (\n                  <option key={crop} value={crop} className=\"bg-slate-900 text-slate-200\">\n                    {crop}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Day Scrubber */}\n            <div className=\"flex items-center space-x-3 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700/60\">\n              <div className=\"flex items-center space-x-1 text-xs text-slate-300 font-medium\">\n                <Calendar className=\"w-3.5 h-3.5 text-cyan-400\" />\n                <span>Day {twinState.currentDay} / 90</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"1\"\n                max=\"90\"\n                value={twinState.currentDay}\n                onChange={(e) => onDayChange(parseInt(e.target.value, 10))}\n                className=\"w-24 h-1.5 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500\"\n              />\n            </div>\n\n            {/* IoT Sync Status */}\n            <div className=\"flex items-center space-x-2 bg-emerald-950/50 border border-emerald-500/30 px-3 py-1.5 rounded-lg text-emerald-400 text-xs font-medium\">\n              <span className=\"relative flex h-2 w-2\">\n                <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n                <span className=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-500\"></span>\n              </span>\n              <Wifi className=\"w-3.5 h-3.5\" />\n              <span>IoT Telemetry Synced</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Navigation Tabs */}\n        <div className=\"flex space-x-1 overflow-x-auto pb-2 scrollbar-none border-t border-slate-800/80 pt-2\">\n          <button\n            onClick={() => onSelectView(\'twin\')}\n     