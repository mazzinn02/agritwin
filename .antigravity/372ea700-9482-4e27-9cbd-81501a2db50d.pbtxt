    instruction: "Apply High Density styling to ParameterGrid.tsx"
    replacement_infos {
      original_chunk {
        target_content: "    <div className=\"space-y-6\">\n      {/* Overview Banner */}\n      <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse\" />\n            <h2 className=\"text-lg font-bold text-slate-100\">The 6 Core Digital Twin Parameters</h2>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-1 max-w-2xl\">\n            Based on the college project blueprint architecture (Figure 1: Main parameters of Digital twin), these six parameters continuously monitor, diagnose, and forecast crop development in real-time.\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-3 text-xs bg-slate-800/80 p-3 rounded-xl border border-slate-700/60\">\n          <div className=\"text-center px-3 border-r border-slate-700\">\n            <div className=\"text-slate-400 text-[10px]\">Active Crop</div>\n            <div className=\"font-bold text-slate-200\">{twinState.cropType}</div>\n          </div>\n          <div className=\"text-center px-3\">\n            <div className=\"text-slate-400 text-[10px]\">Twin Status</div>\n            <div className=\"font-bold text-emerald-400\">Synchronized</div>\n          </div>\n        </div>\n      </div>\n\n      {/* 6 Parameter Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n        {/* Parameter 1: Plant Height Detection */}\n        <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl hover:border-emerald-500/50 transition-all flex flex-col justify-between space-y-4\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2.5 bg-emerald-950/60 border border-emerald-500/30 rounded-xl\">\n                {getIcon(\'height\')}\n              </div>\n              <span className=\"text-[11px] font-mono text-emerald-400 bg-emerald-950/40 px-2 py-0.5 rounded border border-emerald-500/20\">\n                Parameter 1\n              </span>\n            </div>\n\n            <h3 className=\"text-base font-bold text-slate-100 mt-3\">Plant Height Detection</h3>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Measures vertical stem height & internode elongation using stereo camera arrays and LiDAR depth sensors.\n            </p>\n\n            <div className=\"mt-4 p-3 bg-slate-950 rounded-xl border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-xs text-slate-400\">Current Reading:</span>\n              <span className=\"text-xl font-bold text-emerald-400\">{twinState.plantHeightCm.toFixed(1)} cm</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-slate-800/80\">\n            <div className=\"flex items-center justify-between text-xs text-slate-400\">\n              <span>Adjust Height Simulation:</span>\n              <span className=\"font-mono\">{twinState.plantHeightCm.toFixed(1)} cm</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"10\"\n              max=\"220\"\n              step=\"0.5\"\n              value={twinState.plantHeightCm}\n              onChange={(e) => onUpdateState({ plantHeightCm: parseFloat(e.target.value) })}\n              className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500\"\n            />\n          </div>\n        </div>\n\n        {/* Parameter 2: Canopy Coverage Detection */}\n        <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl hover:border-lime-500/50 transition-all flex flex-col justify-between space-y-4\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2.5 bg-lime-950/60 border border-lime-500/30 rounded-xl\">\n                {getIcon(\'canopy\')}\n              </div>\n              <span className=\"text-[11px] font-mono text-lime-400 bg-lime-950/40 px-2 py-0.5 rounded border border-lime-500/20\">\n                Parameter 2\n              </span>\n            </div>\n\n            <h3 className=\"text-base font-bold text-slate-100 mt-3\">Canopy Coverage Detection</h3>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Determines leaf area coverage and light interception ratio using top-down Multispectral NDVI green fraction.\n            </p>\n\n            <div className=\"mt-4 p-3 bg-slate-950 rounded-xl border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-xs text-slate-400\">Canopy Fraction:</span>\n              <span className=\"text-xl font-bold text-lime-400\">{twinState.canopyCoveragePercent.toFixed(1)}%</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-slate-800/80\">\n            <div className=\"flex items-center justify-between text-xs text-slate-400\">\n              <span>Adjust Canopy %:</span>\n              <span className=\"font-mono\">{twinState.canopyCoveragePercent.toFixed(1)}%</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"5\"\n              max=\"100\"\n              step=\"0.5\"\n              value={twinState.canopyCoveragePercent}\n              onChange={(e) => onUpdateState({ canopyCoveragePercent: parseFloat(e.target.value) })}\n              className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-lime-500\"\n            />\n          </div>\n        </div>\n\n        {/* Parameter 3: Growth Detection */}\n        <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl hover:border-cyan-500/50 transition-all flex flex-col justify-between space-y-4\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2.5 bg-cyan-950/60 border border-cyan-500/30 rounded-xl\">\n                {getIcon(\'growth\')}\n              </div>\n              <span className=\"text-[11px] font-mono text-cyan-400 bg-cyan-950/40 px-2 py-0.5 rounded border border-cyan-500/20\">\n                Parameter 3\n              </span>\n            </div>\n\n            <h3 className=\"text-base font-bold text-slate-100 mt-3\">Growth Detection</h3>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Tracks changes in plant size and biomass volume over time to calculate growth velocity and phenology phase.\n            </p>\n\n            <div className=\"mt-4 p-3 bg-slate-950 rounded-xl border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-xs text-slate-400\">Growth Velocity:</span>\n              <span className=\"text-xl font-bold text-cyan-400\">+{twinState.growthRateCmPerDay.toFixed(1)} cm/day</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-slate-800/80\">\n            <div className=\"flex items-center justify-between text-xs text-slate-400\">\n              <span>Adjust Growth Rate:</span>\n              <span className=\"font-mono\">+{twinState.growthRateCmPerDay.toFixed(1)} cm/d</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"0.1\"\n              max=\"5.0\"\n              step=\"0.1\"\n              value={twinState.growthRateCmPerDay}\n              onChange={(e) => onUpdateState({ growthRateCmPerDay: parseFloat(e.target.value) })}\n              className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-500\"\n            />\n          </div>\n        </div>\n\n        {/* Parameter 4: Disease Detection */}\n        <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl hover:border-red-500/50 transition-all flex flex-col justify-between space-y-4\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2.5 bg-red-950/60 border border-red-500/30 rounded-xl\">\n                {getIcon(\'disease\')}\n              </div>\n              <span className=\"text-[11px] font-mono text-red-400 bg-red-950/40 px-2 py-0.5 rounded border border-red-500/20\">\n                Parameter 4\n              </span>\n            </div>\n\n            <h3 className=\"text-base font-bold text-slate-100 mt-3\">Disease Detection</h3>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Identifies health issues, early pathogen lesions, powdery mildew, or nitrogen deficiency via Gemini AI vision.\n            </p>\n\n            <div className=\"mt-4 p-3 bg-slate-950 rounded-xl border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-xs text-slate-400\">Disease Vulnerability:</span>\n              <span className=\"text-xl font-bold text-red-400\">{twinState.diseaseRiskPercent.toFixed(1)}%</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-slate-800/80\">\n            <div className=\"flex items-center justify-between text-xs text-slate-400\">\n              <span>Adjust Disease Risk:</span>\n              <span className=\"font-mono\">{twinState.diseaseRiskPercent.toFixed(1)}%</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"0\"\n              max=\"60\"\n              step=\"1\"\n              value={twinState.diseaseRiskPercent}\n              onChange={(e) => onUpdateState({ diseaseRiskPercent: parseFloat(e.target.value) })}\n              className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-red-500\"\n            />\n          </div>\n        </div>\n\n        {/* Parameter 5: Fruit Ripeness Detection */}\n        <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl hover:border-amber-500/50 transition-all flex flex-col justify-between space-y-4\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2.5 bg-amber-950/60 border border-amber-500/30 rounded-xl\">\n                {getIcon(\'ripeness\')}\n              </div>\n              <span className=\"text-[11px] font-mono text-amber-400 bg-amber-950/40 px-2 py-0.5 rounded border border-amber-500/20\">\n                Parameter 5\n              </span>\n            </div>\n\n            <h3 className=\"text-base font-bold text-slate-100 mt-3\">Fruit Ripeness Detection</h3>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Assesses maturity of fruits & grains using RGB color histogram indexing (unripe green \342\206\222 optimal harvest red/gold).\n            </p>\n\n            <div className=\"mt-4 p-3 bg-slate-950 rounded-xl border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-xs text-slate-400\">Maturity Ratio:</span>\n              <span className=\"text-xl font-bold text-amber-400\">{twinState.fruitRipenessPercent.toFixed(1)}%</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-slate-800/80\">\n            <div className=\"flex items-center justify-between text-xs text-slate-400\">\n              <span>Adjust Ripeness %:</span>\n              <span className=\"font-mono\">{twinState.fruitRipenessPercent.toFixed(1)}%</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"0\"\n              max=\"100\"\n              step=\"1\"\n              value={twinState.fruitRipenessPercent}\n              onChange={(e) => onUpdateState({ fruitRipenessPercent: parseFloat(e.target.value) })}\n              className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-500\"\n            />\n          </div>\n        </div>\n\n        {/* Parameter 6: Crop Yield Estimation */}\n        <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl hover:border-purple-500/50 transition-all flex flex-col justify-between space-y-4\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2.5 bg-purple-950/60 border border-purple-500/30 rounded-xl\">\n                {getIcon(\'yield\')}\n              </div>\n              <span className=\"text-[11px] font-mono text-purple-400 bg-purple-950/40 px-2 py-0.5 rounded border border-purple-500/20\">\n                Parameter 6\n              </span>\n            </div>\n\n            <h3 className=\"text-base font-bold text-slate-100 mt-3\">Crop Yield Estimation</h3>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Predicts total expected harvest weight (kg/m\302\262) by combining height, canopy, health, and climate parameters.\n            </p>\n\n            <div className=\"mt-4 p-3 bg-slate-950 rounded-xl border border-slate-800/80 flex items-center justify-between\">\n              <span className=\"text-xs text-slate-400\">Predicted Harvest:</span>\n              <span className=\"text-xl font-bold text-purple-400\">{twinState.estimatedYieldKgPerM2.toFixed(1)} kg/m\302\262</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-slate-800/80\">\n            <div className=\"flex items-center justify-between text-xs text-slate-400\">\n              <span>Adjust Yield Forecast:</span>\n              <span className=\"font-mono\">{twinState.estimatedYieldKgPerM2.toFixed(1)} kg/m\302\262</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"1.0\"\n              max=\"25.0\"\n              step=\"0.2\"\n              value={twinState.estimatedYieldKgPerM2}\n              onChange={(e) => onUpdateState({ estimatedYieldKgPerM2: parseFloat(e.target.value) })}\n              className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-purple-500\"\n            />\n          </div>\n        </div>\n      </div>\n    </div>"
        replacement_content: "    <div className=\"space-y-6\">\n      {/* Overview Banner */}\n      <div className=\"bg-white border-2 border-[#141414] p-4 flex flex-col md:flex-row md:items-center justify-between gap-4 uppercase font-mono\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"w-2.5 h-2.5 bg-[#141414] animate-pulse\" />\n            <h2 className=\"text-base font-bold text-[#141414]\">The 6 Core Digital Twin Parameters</h2>\n          </div>\n          <p className=\"text-[10px] text-[#141414]/70 mt-1 max-w-2xl font-bold\">\n            Based on the college project blueprint architecture, these six parameters continuously monitor, diagnose, and forecast crop development in real-time.\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-3 text-[10px] bg-[#E4E3E0] p-2 border border-[#141414]\">\n          <div className=\"text-center px-2 border-r border-[#141414]\">\n            <div className=\"text-[#141414] font-bold\">Active Crop</div>\n            <div className=\"font-bold text-[#141414]\">{twinState.cropType}</div>\n          </div>\n          <div className=\"text-center px-2\">\n            <div className=\"text-[#141414] font-bold\">Twin Status</div>\n            <div className=\"font-bold text-[#141414]\">Synchronized</div>\n          </div>\n        </div>\n      </div>\n\n      {/* 6 Parameter Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n        {/* Parameter 1: Plant Height Detection */}\n        <div className=\"bg-white border-2 border-[#141414] p-4 hover:bg-[#F9F9F9] transition-all flex flex-col justify-between space-y-4 uppercase font-mono\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2 border border-[#141414]\">\n                {getIcon(\'height\')}\n              </div>\n              <span className=\"text-[10px] font-bold text-[#141414] border border-[#141414] px-1 py-0.5\">\n                Parameter 1\n              </span>\n            </div>\n\n            <h3 className=\"text-sm font-bold text-[#141414] mt-3\">Plant Height Detection</h3>\n            <p className=\"text-[10px] font-bold text-[#141414]/70 mt-1\">\n              Measures vertical stem height & internode elongation using stereo camera arrays and LiDAR depth sensors.\n            </p>\n\n            <div className=\"mt-4 p-2 bg-[#E4E3E0] border border-[#141414] flex items-center justify-between\">\n              <span className=\"text-[10px] font-bold text-[#141414]\">Current Reading:</span>\n              <span className=\"text-lg font-bold text-[#141414]\">{twinState.plantHeightCm.toFixed(1)} cm</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-[#141414]\">\n            <div className=\"flex items-center justify-between text-[10px] font-bold text-[#141414]\">\n              <span>Adjust Height Simulation:</span>\n              <span>{twinState.plantHeightCm.toFixed(1)} cm</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"10\"\n              max=\"220\"\n              step=\"0.5\"\n              value={twinState.plantHeightCm}\n              onChange={(e) => onUpdateState({ plantHeightCm: parseFloat(e.target.value) })}\n              className=\"w-full h-1 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n            />\n          </div>\n        </div>\n\n        {/* Parameter 2: Canopy Coverage Detection */}\n        <div className=\"bg-white border-2 border-[#141414] p-4 hover:bg-[#F9F9F9] transition-all flex flex-col justify-between space-y-4 uppercase font-mono\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2 border border-[#141414]\">\n                {getIcon(\'canopy\')}\n              </div>\n              <span className=\"text-[10px] font-bold text-[#141414] border border-[#141414] px-1 py-0.5\">\n                Parameter 2\n              </span>\n            </div>\n\n            <h3 className=\"text-sm font-bold text-[#141414] mt-3\">Canopy Coverage Detection</h3>\n            <p className=\"text-[10px] font-bold text-[#141414]/70 mt-1\">\n              Determines leaf area coverage and light interception ratio using top-down Multispectral NDVI green fraction.\n            </p>\n\n            <div className=\"mt-4 p-2 bg-[#E4E3E0] border border-[#141414] flex items-center justify-between\">\n              <span className=\"text-[10px] font-bold text-[#141414]\">Canopy Fraction:</span>\n              <span className=\"text-lg font-bold text-[#141414]\">{twinState.canopyCoveragePercent.toFixed(1)}%</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-[#141414]\">\n            <div className=\"flex items-center justify-between text-[10px] font-bold text-[#141414]\">\n              <span>Adjust Canopy %:</span>\n              <span>{twinState.canopyCoveragePercent.toFixed(1)}%</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"5\"\n              max=\"100\"\n              step=\"0.5\"\n              value={twinState.canopyCoveragePercent}\n              onChange={(e) => onUpdateState({ canopyCoveragePercent: parseFloat(e.target.value) })}\n              className=\"w-full h-1 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n            />\n          </div>\n        </div>\n\n        {/* Parameter 3: Growth Detection */}\n        <div className=\"bg-white border-2 border-[#141414] p-4 hover:bg-[#F9F9F9] transition-all flex flex-col justify-between space-y-4 uppercase font-mono\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2 border border-[#141414]\">\n                {getIcon(\'growth\')}\n              </div>\n              <span className=\"text-[10px] font-bold text-[#141414] border border-[#141414] px-1 py-0.5\">\n                Parameter 3\n              </span>\n            </div>\n\n            <h3 className=\"text-sm font-bold text-[#141414] mt-3\">Growth Detection</h3>\n            <p className=\"text-[10px] font-bold text-[#141414]/70 mt-1\">\n              Tracks changes in plant size and biomass volume over time to calculate growth velocity and phenology phase.\n            </p>\n\n            <div className=\"mt-4 p-2 bg-[#E4E3E0] border border-[#141414] flex items-center justify-between\">\n              <span className=\"text-[10px] font-bold text-[#141414]\">Growth Velocity:</span>\n              <span className=\"text-lg font-bold text-[#141414]\">+{twinState.growthRateCmPerDay.toFixed(1)} cm/day</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-[#141414]\">\n            <div className=\"flex items-center justify-between text-[10px] font-bold text-[#141414]\">\n              <span>Adjust Growth Rate:</span>\n              <span>+{twinState.growthRateCmPerDay.toFixed(1)} cm/d</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"0.1\"\n              max=\"5.0\"\n              step=\"0.1\"\n              value={twinState.growthRateCmPerDay}\n              onChange={(e) => onUpdateState({ growthRateCmPerDay: parseFloat(e.target.value) })}\n              className=\"w-full h-1 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n            />\n          </div>\n        </div>\n\n        {/* Parameter 4: Disease Detection */}\n        <div className=\"bg-white border-2 border-[#141414] p-4 hover:bg-[#F9F9F9] transition-all flex flex-col justify-between space-y-4 uppercase font-mono\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2 border border-[#141414]\">\n                {getIcon(\'disease\')}\n              </div>\n              <span className=\"text-[10px] font-bold text-[#141414] border border-[#141414] px-1 py-0.5\">\n                Parameter 4\n              </span>\n            </div>\n\n            <h3 className=\"text-sm font-bold text-[#141414] mt-3\">Disease Detection</h3>\n            <p className=\"text-[10px] font-bold text-[#141414]/70 mt-1\">\n              Identifies health issues, early pathogen lesions, powdery mildew, or nitrogen deficiency via Gemini AI vision.\n            </p>\n\n            <div className=\"mt-4 p-2 bg-[#E4E3E0] border border-[#141414] flex items-center justify-between\">\n              <span className=\"text-[10px] font-bold text-[#141414]\">Disease Vulnerability:</span>\n              <span className=\"text-lg font-bold text-[#141414]\">{twinState.diseaseRiskPercent.toFixed(1)}%</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-[#141414]\">\n            <div className=\"flex items-center justify-between text-[10px] font-bold text-[#141414]\">\n              <span>Adjust Disease Risk:</span>\n              <span>{twinState.diseaseRiskPercent.toFixed(1)}%</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"0\"\n              max=\"60\"\n              step=\"1\"\n              value={twinState.diseaseRiskPercent}\n              onChange={(e) => onUpdateState({ diseaseRiskPercent: parseFloat(e.target.value) })}\n              className=\"w-full h-1 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n            />\n          </div>\n        </div>\n\n        {/* Parameter 5: Fruit Ripeness Detection */}\n        <div className=\"bg-white border-2 border-[#141414] p-4 hover:bg-[#F9F9F9] transition-all flex flex-col justify-between space-y-4 uppercase font-mono\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2 border border-[#141414]\">\n                {getIcon(\'ripeness\')}\n              </div>\n              <span className=\"text-[10px] font-bold text-[#141414] border border-[#141414] px-1 py-0.5\">\n                Parameter 5\n              </span>\n            </div>\n\n            <h3 className=\"text-sm font-bold text-[#141414] mt-3\">Fruit Ripeness Detection</h3>\n            <p className=\"text-[10px] font-bold text-[#141414]/70 mt-1\">\n              Assesses maturity of fruits & grains using RGB color histogram indexing (unripe green \342\206\222 optimal harvest red/gold).\n            </p>\n\n            <div className=\"mt-4 p-2 bg-[#E4E3E0] border border-[#141414] flex items-center justify-between\">\n              <span className=\"text-[10px] font-bold text-[#141414]\">Maturity Ratio:</span>\n              <span className=\"text-lg font-bold text-[#141414]\">{twinState.fruitRipenessPercent.toFixed(1)}%</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-[#141414]\">\n            <div className=\"flex items-center justify-between text-[10px] font-bold text-[#141414]\">\n              <span>Adjust Ripeness %:</span>\n              <span>{twinState.fruitRipenessPercent.toFixed(1)}%</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"0\"\n              max=\"100\"\n              step=\"1\"\n              value={twinState.fruitRipenessPercent}\n              onChange={(e) => onUpdateState({ fruitRipenessPercent: parseFloat(e.target.value) })}\n              className=\"w-full h-1 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n            />\n          </div>\n        </div>\n\n        {/* Parameter 6: Crop Yield Estimation */}\n        <div className=\"bg-white border-2 border-[#141414] p-4 hover:bg-[#F9F9F9] transition-all flex flex-col justify-between space-y-4 uppercase font-mono\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"p-2 border border-[#141414]\">\n                {getIcon(\'yield\')}\n              </div>\n              <span className=\"text-[10px] font-bold text-[#141414] border border-[#141414] px-1 py-0.5\">\n                Parameter 6\n              </span>\n            </div>\n\n            <h3 className=\"text-sm font-bold text-[#141414] mt-3\">Crop Yield Estimation</h3>\n            <p className=\"text-[10px] font-bold text-[#141414]/70 mt-1\">\n              Predicts total expected harvest weight (kg/m\302\262) by combining height, canopy, health, and climate parameters.\n            </p>\n\n            <div className=\"mt-4 p-2 bg-[#E4E3E0] border border-[#141414] flex items-center justify-between\">\n              <span className=\"text-[10px] font-bold text-[#141414]\">Predicted Harvest:</span>\n              <span className=\"text-lg font-bold text-[#141414]\">{twinState.estimatedYieldKgPerM2.toFixed(1)} kg/m\302\262</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 pt-2 border-t border-[#141414]\">\n            <div className=\"flex items-center justify-between text-[10px] font-bold text-[#141414]\">\n              <span>Adjust Yield Forecast:</span>\n              <span>{twinState.estimatedYieldKgPerM2.toFixed(1)} kg/m\302\262</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"1.0\"\n              max=\"25.0\"\n              step=\"0.2\"\n              value={twinState.estimatedYieldKgPerM2}\n              onChange={(e) => onUpdateState({ estimatedYieldKgPerM2: parseFloat(e.target.value) })}\n              className=\"w-full h-1 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n            />\n          </div>\n        </div>\n      </div>\n    </div>"
