    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { DigitalTwinCropState } from \'../types\';\nimport { \n  ResponsiveContainer, \n  AreaChart, \n  Area, \n  XAxis, \n  YAxis, \n  Tooltip, \n  CartesianGrid,\n  LineChart,\n  Line,\n  BarChart,\n  Bar\n} from \'recharts\';\nimport { TrendingUp, BarChart3, Sprout, AlertCircle } from \'lucide-react\';\n\ninterface AnalyticsChartsProps {\n  twinState: DigitalTwinCropState;\n}\n\nexport const AnalyticsCharts: React.FC<AnalyticsChartsProps> = ({ twinState }) => {\n  // Generate 12 time points representing growth cycle progression up to current day\n  const generateGrowthHistory = () => {\n    const points = [];\n    const totalDays = twinState.currentDay;\n    const step = Math.max(1, Math.floor(totalDays / 12));\n\n    for (let day = 1; day <= totalDays; day += step) {\n      const progressRatio = day / 90;\n      // Exponential growth curve for plant height\n      const height = Math.min(twinState.plantHeightCm, (Math.pow(progressRatio, 1.3) * twinState.plantHeightCm * 1.1) + 5);\n      // S-curve for canopy\n      const canopy = Math.min(100, (1 / (1 + Math.exp(-6 * (progressRatio - 0.4)))) * twinState.canopyCoveragePercent * 1.05);\n      // Disease fluctuation\n      const disease = Math.max(2, Math.sin(day * 0.2) * 5 + twinState.diseaseRiskPercent);\n      // Ripeness starts around day 40\n      const ripeness = day < 35 ? 0 : Math.min(100, Math.pow((day - 35) / 55, 1.5) * twinState.fruitRipenessPercent * 1.1);\n      // Yield projection\n      const yieldVal = (height / 200) * (canopy / 100) * twinState.estimatedYieldKgPerM2;\n\n      points.push({\n        day: `Day ${day}`,\n        height: parseFloat(height.toFixed(1)),\n        canopy: parseFloat(canopy.toFixed(1)),\n        disease: parseFloat(disease.toFixed(1)),\n        ripeness: parseFloat(ripeness.toFixed(1)),\n        yieldVal: parseFloat(yieldVal.toFixed(2)),\n      });\n    }\n    return points;\n  };\n\n  const chartData = generateGrowthHistory();\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <div className=\"flex items-center space-x-2\">\n            <BarChart3 className=\"w-5 h-5 text-emerald-400\" />\n            <h2 className=\"text-lg font-bold text-slate-100\">6-Parameter Time Series Telemetry</h2>\n          </div>\n          <span className=\"text-xs text-slate-400 font-mono\">\n            Season Tracking: Day 1 to Day {twinState.currentDay}\n          </span>\n        </div>\n        <p className=\"text-xs text-slate-400\">\n          Digital Twin biometric progression curves comparing plant height, leaf canopy coverage, health risk index, ripeness curve, and predicted harvest yield.\n        </p>\n      </div>\n\n      {/* Row 1: Plant Height & Canopy Coverage Charts */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Chart 1: Height (Parameter 1) */}\n        <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-sm font-bold text-slate-200 flex items-center space-x-2\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-400\" />\n              <span>Plant Height Growth Trajectory (cm)</span>\n            </h3>\n            <span className=\"text-xs font-mono text-emerald-400 font-bold\">{twinState.plantHeightCm.toFixed(1)} cm</span>\n          </div>\n\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={chartData}>\n                <defs>\n                  <linearGradient id=\"heightGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#10b981\" stopOpacity={0.4} />\n                    <stop offset=\"95%\" stopColor=\"#10b981\" stopOpacity={0.0} />\n                  </linearGradient>\n                </defs>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#334155\" opacity={0.5} />\n                <XAxis dataKey=\"day\" stroke=\"#94a3b8\" fontSize={11} />\n                <YAxis stroke=\"#94a3b8\" fontSize={11} unit=\"cm\" />\n                <Tooltip\n                  contentStyle={{ backgroundColor: \'#0f172a\', borderColor: \'#334155\', borderRadius: \'0.75rem\', fontSize: \'12px\' }}\n                />\n                <Area type=\"monotone\" dataKey=\"height\" stroke=\"#10b981\" strokeWidth={3} fillOpacity={1} fill=\"url(#heightGrad)\" />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Chart 2: Canopy Coverage (Parameter 2) */}\n        <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-sm font-bold text-slate-200 flex items-center space-x-2\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-lime-400\" />\n              <span>Canopy Leaf Area Coverage (%)</span>\n            </h3>\n            <span className=\"text-xs font-mono text-lime-400 font-bold\">{twinState.canopyCoveragePercent.toFixed(1)}%</span>\n          </div>\n\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={chartData}>\n                <defs>\n                  <linearGradient id=\"canopyGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#84cc16\" stopOpacity={0.4} />\n                    <stop offset=\"95%\" stopColor=\"#84cc16\" stopOpacity={0.0} />\n                  </linearGradient>\n                </defs>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#334155\" opacity={0.5} />\n                <XAxis dataKey=\"day\" stroke=\"#94a3b8\" fontSize={11} />\n                <YAxis stroke=\"#94a3b8\" fontSize={11} unit=\"%\" />\n                <Tooltip\n                  contentStyle={{ backgroundColor: \'#0f172a\', borderColor: \'#334155\', borderRadius: \'0.75rem\', fontSize: \'12px\' }}\n                />\n                <Area type=\"monotone\" dataKey=\"canopy\" stroke=\"#84cc16\" strokeWidth={3} fillOpacity={1} fill=\"url(#canopyGrad)\" />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n      </div>\n\n      {/* Row 2: Disease Risk & Yield Forecasting */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Chart 3: Disease Risk (Parameter 4) */}\n        <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-sm font-bold text-slate-200 flex items-center space-x-2\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-red-400\" />\n              <span>Pathogen & Disease Vulnerability Index (%)</span>\n            </h3>\n            <span className=\"text-xs font-mono text-red-400 font-bold\">{twinState.diseaseRiskPercent.toFixed(1)}% Risk</span>\n          </div>\n\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <LineChart data={chartData}>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#334155\" opacity={0.5} />\n                <XAxis dataKey=\"day\" stroke=\"#94a3b8\" fontSize={11} />\n                <YAxis stroke=\"#94a3b8\" fontSize={11} unit=\"%\" />\n                <Tooltip\n                  contentStyle={{ backgroundColor: \'#0f172a\', borderColor: \'#334155\', borderRadius: \'0.75rem\', fontSize: \'12px\' }}\n                />\n                <Line type=\"monotone\" dataKey=\"disease\" stroke=\"#ef4444\" strokeWidth={3} dot={{ fill: \'#ef4444\', r: 4 }} />\n              </LineChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Chart 4: Yield Estimation (Parameter 6) */}\n        <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-sm font-bold text-slate-200 flex items-center space-x-2\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-purple-400\" />\n              <span>Projected Crop Harvest Yield (kg/m\302\262)</span>\n            </h3>\n            <span className=\"text-xs font-mono text-purple-400 font-bold\">{twinState.estimatedYieldKgPerM2.toFixed(1)} kg/m\302\262</span>\n          </div>\n\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <BarChart data={chartData}>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#334155\" opacity={0.5} />\n                <XAxis dataKey=\"day\" stroke=\"#94a3b8\" fontSize={11} />\n                <YAxis stroke=\"#94a3b8\" fontSize={11} unit=\"kg\" />\n                <Tooltip\n                  contentStyle={{ backgroundColor: \'#0f172a\', borderColor: \'#334155\', borderRadius: \'0.75rem\', fontSize: \'12px\' }}\n                />\n                <Bar dataKey=\"yieldVal\" fill=\"#8b5cf6\" radius={[6, 6, 0, 0]} />\n              </BarChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
