           </div>\n          </div>\n\n          <div className=\"flex items-center space-x-3\">\n            <div className={`p-3 rounded-xl ${isHarvestReady ? \'bg-emerald-100 text-emerald-600\' : \'bg-slate-100 text-slate-500\'}`}>\n              <Calendar className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <p className=\"text-sm text-slate-500 font-medium\">Harvest Readiness</p>\n              <p className={`text-xl font-bold ${isHarvestReady ? \'text-emerald-600\' : \'text-slate-900\'}`}>\n                {isHarvestReady ? \'Ready for Harvest\' : \'Not Ready\'}\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"bg-white p-6 rounded-2xl shadow-sm border border-slate-100 lg:col-span-2 flex flex-col\">\n          <h3 className=\"text-lg font-bold text-slate-900 mb-4\">Ripeness Distribution Categories</h3>\n          <div className=\"flex-1 min-h-[300px]\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <PieChart>\n                <Pie\n                  data={data}\n                  cx=\"50%\"\n                  cy=\"50%\"\n                  innerRadius={80}\n                  outerRadius={120}\n                  paddingAngle={5}\n                  dataKey=\"value\"\n                >\n                  {data.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={entry.color} />\n                  ))}\n                </Pie>\n                <RechartsTooltip \n                  formatter={(value: number) => [`${value.toFixed(1)}%`, \'\']}\n                  contentStyle={{ borderRadius: \'12px\', border: \'none\', boxShadow: \'0 4px 6px -1px rgb(0 0 0 / 0.1)\' }}\n                />\n                <Legend verticalAlign=\"bottom\" height={36} iconType=\"circle\" />\n              </PieChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
