    instruction: "Apply High Density style to AiVisionScanner.tsx"
    replacement_infos {
      original_chunk {
        target_content: "    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-6 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <Camera className=\"w-5 h-5 text-purple-400\" />\n            <h2 className=\"text-lg font-bold text-slate-100\">AI Plant Vision & 6-Parameter Extractor</h2>\n          </div>\n          <p className=\"text-xs text-slate-400 mt-1 max-w-2xl\">\n            Upload a plant or field photo to run Gemini 2.5 Flash server-side computer vision. Automatically detects Plant Height, Canopy %, Growth Stage, Disease, Ripeness %, and Estimated Yield.\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-2 bg-purple-950/40 border border-purple-500/30 px-3 py-1.5 rounded-lg text-xs font-semibold text-purple-300\">\n          <Sparkles className=\"w-4 h-4 text-purple-400\" />\n          <span>Server-Side Gemini API</span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Photo Upload & Selector (5 Cols) */}\n        <div className=\"lg:col-span-5 bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-4\">\n          <h3 className=\"text-sm font-semibold text-slate-200 flex items-center space-x-2\">\n            <Upload className=\"w-4 h-4 text-emerald-400\" />\n            <span>Select or Upload Field Image</span>\n          </h3>\n\n          {/* Preset Sample Photos */}\n          <div className=\"space-y-2\">\n            <span className=\"text-xs text-slate-400 font-medium\">Or choose sample field photo:</span>\n            <div className=\"grid grid-cols-3 gap-2\">\n              {SAMPLE_PHOTOS.map((sample, idx) => (\n                <button\n                  key={idx}\n                  onClick={() => {\n                    setImagePreview(sample.url);\n                    setAnalysisResult(null);\n                    setErrorMessage(null);\n                  }}\n                  className={`p-1 rounded-lg border text-left overflow-hidden transition-all ${\n                    imagePreview === sample.url\n                      ? \'border-emerald-500 ring-2 ring-emerald-500/30\'\n                      : \'border-slate-800 hover:border-slate-700\'\n                  }`}\n                >\n                  <img src={sample.url} alt={sample.name} className=\"w-full h-16 object-cover rounded-md\" />\n                  <span className=\"text-[10px] text-slate-300 font-medium block truncate mt-1\">{sample.name}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Custom File Upload Box */}\n          <div className=\"relative border-2 border-dashed border-slate-800 hover:border-slate-700 rounded-xl p-4 text-center cursor-pointer transition-colors bg-slate-950/50\">\n            <input\n              type=\"file\"\n              accept=\"image/*\"\n              onChange={handleFileUpload}\n              className=\"absolute inset-0 opacity-0 cursor-pointer\"\n            />\n            <Camera className=\"w-8 h-8 text-slate-500 mx-auto mb-2\" />\n            <span className=\"text-xs font-semibold text-slate-300 block\">Click to upload custom plant photo</span>\n            <span className=\"text-[10px] text-slate-500 block\">Supports JPG, PNG, WEBP</span>\n          </div>\n\n          {/* Crop Context Input */}\n          <div className=\"space-y-1\">\n            <label className=\"text-xs text-slate-400 font-medium\">Crop Type / Field Context:</label>\n            <input\n              type=\"text\"\n              value={cropContext}\n              onChange={(e) => setCropContext(e.target.value)}\n              placeholder=\"e.g. Winter Wheat, Roma Tomato\"\n              className=\"w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-emerald-500\"\n            />\n          </div>\n\n          {/* Preview & Run Button */}\n          {imagePreview && (\n            <div className=\"space-y-3 pt-2 border-t border-slate-800\">\n              <div className=\"relative rounded-xl overflow-hidden border border-slate-800 max-h-48\">\n                <img src={imagePreview} alt=\"Selected Crop\" className=\"w-full h-48 object-cover\" />\n              </div>\n\n              <button\n                onClick={handleRunAnalysis}\n                disabled={isAnalyzing}\n                className=\"w-full py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold rounded-xl text-xs flex items-center justify-center space-x-2 shadow-lg shadow-purple-500/20 transition-all disabled:opacity-50\"\n              >\n                {isAnalyzing ? (\n                  <>\n                    <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                    <span>Gemini AI Analyzing 6 Parameters...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4\" />\n                    <span>Run Gemini AI Vision Scan</span>\n                  </>\n                )}\n              </button>\n            </div>\n          )}\n\n          {errorMessage && (\n            <div className=\"p-3 bg-red-950/50 border border-red-500/50 text-red-300 rounded-xl text-xs flex items-center space-x-2\">\n              <AlertTriangle className=\"w-4 h-4 text-red-400 shrink-0\" />\n              <span>{errorMessage}</span>\n            </div>\n          )}\n        </div>\n\n        {/* AI Extracted 6-Parameter Results (7 Cols) */}\n        <div className=\"lg:col-span-7 bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-5\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <h3 className=\"text-sm font-semibold text-slate-200 flex items-center space-x-2\">\n              <Sparkles className=\"w-4 h-4 text-purple-400\" />\n              <span>Extracted Digital Twin Parameters</span>\n            </h3>\n            {analysisResult && (\n              <button\n                onClick={handleSyncToTwin}\n                className=\"px-3 py-1.5 bg-emerald-500 text-slate-950 font-bold rounded-lg text-xs flex items-center space-x-1.5 shadow-md shadow-emerald-500/20 hover:bg-emerald-400 transition-all\"\n              >\n                <CheckCircle2 className=\"w-4 h-4\" />\n                <span>Sync with Digital Twin</span>\n              </button>\n            )}\n          </div>\n\n          {!analysisResult ? (\n            <div className=\"py-16 text-center space-y-3\">\n              <div className=\"w-12 h-12 rounded-2xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center mx-auto text-slate-500\">\n                <Camera className=\"w-6 h-6\" />\n              </div>\n              <p className=\"text-xs text-slate-400 max-w-sm mx-auto\">\n                Select an image on the left and click \"Run Gemini AI Vision Scan\" to extract the 6 main parameters automatically.\n              </p>\n            </div>\n          ) : (\n            <div className=\"space-y-4\">\n              {/* Confidence badge */}\n              <div className=\"flex items-center justify-between text-xs bg-slate-950 p-3 rounded-xl border border-slate-800\">\n                <span className=\"text-slate-400 font-medium\">AI Confidence Score:</span>\n                <span className=\"font-bold text-emerald-400\">{(analysisResult.confidenceScore * 100).toFixed(0)}%</span>\n              </div>\n\n              {/* 6 Parameter Output Grid */}\n              <div className=\"grid grid-cols-2 gap-3\">\n                {/* 1. Height */}\n                <div className=\"p-3 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-xs text-slate-400\">\n                    <Ruler className=\"w-3.5 h-3.5 text-emerald-400\" />\n                    <span>1. Height Estimate</span>\n                  </div>\n                  <div className=\"text-lg font-bold text-emerald-400\">{analysisResult.plantHeightEstimateCm} cm</div>\n                </div>\n\n                {/* 2. Canopy */}\n                <div className=\"p-3 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-xs text-slate-400\">\n                    <Maximize className=\"w-3.5 h-3.5 text-lime-400\" />\n                    <span>2. Canopy Coverage</span>\n                  </div>\n                  <div className=\"text-lg font-bold text-lime-400\">{analysisResult.canopyCoveragePercent}%</div>\n                </div>\n\n                {/* 3. Growth Stage */}\n                <div className=\"p-3 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-xs text-slate-400\">\n                    <TrendingUp className=\"w-3.5 h-3.5 text-cyan-400\" />\n                    <span>3. Growth Stage</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-cyan-400 truncate\">{analysisResult.growthStage}</div>\n                </div>\n\n                {/* 4. Disease */}\n                <div className=\"p-3 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-xs text-slate-400\">\n                    <ShieldAlert className=\"w-3.5 h-3.5 text-red-400\" />\n                    <span>4. Health / Disease</span>\n                  </div>\n                  <div className=\"text-xs font-bold text-red-400 truncate\">\n                    {analysisResult.healthAssessment.diseaseName} ({analysisResult.healthAssessment.riskScore}%)\n                  </div>\n                </div>\n\n                {/* 5. Ripeness */}\n                <div className=\"p-3 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-xs text-slate-400\">\n                    <Apple className=\"w-3.5 h-3.5 text-amber-400\" />\n                    <span>5. Fruit Ripeness</span>\n                  </div>\n                  <div className=\"text-lg font-bold text-amber-400\">{analysisResult.fruitRipeness.ripenessPercent}%</div>\n                </div>\n\n                {/* 6. Yield */}\n                <div className=\"p-3 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-xs text-slate-400\">\n                    <Sprout className=\"w-3.5 h-3.5 text-purple-400\" />\n                    <span>6. Yield Estimate</span>\n                  </div>\n                  <div className=\"text-lg font-bold text-purple-400\">{analysisResult.yieldProjectionKgPerM2} kg/m\302\262</div>\n                </div>\n              </div>\n\n              {/* Recommended Action & Key Observations */}\n              <div className=\"p-3.5 bg-slate-950 rounded-xl border border-slate-800 space-y-2 text-xs\">\n                <span className=\"text-slate-400 font-semibold block\">AI Treatment Recommendation:</span>\n                <p className=\"text-slate-300 leading-relaxed\">{analysisResult.healthAssessment.recommendedAction}</p>\n\n                {analysisResult.keyObservations?.length > 0 && (\n                  <div className=\"pt-2 border-t border-slate-800\">\n                    <span className=\"text-slate-400 font-semibold block mb-1\">Key Observations:</span>\n                    <ul className=\"list-disc list-inside space-y-0.5 text-slate-300\">\n                      {analysisResult.keyObservations.map((obs, idx) => (\n                        <li key={idx}>{obs}</li>\n                      ))}\n                    </ul>\n                  </div>\n                )}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>"
        replacement_content: "    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-white border-2 border-[#141414] p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 uppercase font-mono\">\n        <div>\n          <div className=\"flex items-center space-x-2 border-b-2 border-[#141414] pb-2 mb-2 inline-flex pr-4\">\n            <Camera className=\"w-5 h-5 text-[#141414]\" />\n            <h2 className=\"text-base font-bold text-[#141414]\">AI Plant Vision & 6-Parameter Extractor</h2>\n          </div>\n          <p className=\"text-[10px] text-[#141414]/80 font-bold max-w-2xl\">\n            Upload a plant or field photo to run Gemini 2.5 Flash server-side computer vision. Automatically detects Plant Height, Canopy %, Growth Stage, Disease, Ripeness %, and Estimated Yield.\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-2 bg-[#141414] text-white px-3 py-1.5 text-[10px] font-bold whitespace-nowrap\">\n          <Sparkles className=\"w-3 h-3 text-white\" />\n          <span>Server-Side Gemini API</span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 font-mono uppercase\">\n        {/* Photo Upload & Selector (5 Cols) */}\n        <div className=\"lg:col-span-5 bg-white border-2 border-[#141414] p-4 space-y-4\">\n          <h3 className=\"text-sm font-bold text-[#141414] flex items-center space-x-2 border-b-2 border-[#141414] pb-2\">\n            <Upload className=\"w-4 h-4 text-[#141414]\" />\n            <span>Select or Upload Image</span>\n          </h3>\n\n          {/* Preset Sample Photos */}\n          <div className=\"space-y-2\">\n            <span className=\"text-[10px] text-[#141414] font-bold\">Or choose sample photo:</span>\n            <div className=\"grid grid-cols-3 gap-2\">\n              {SAMPLE_PHOTOS.map((sample, idx) => (\n                <button\n                  key={idx}\n                  onClick={() => {\n                    setImagePreview(sample.url);\n                    setAnalysisResult(null);\n                    setErrorMessage(null);\n                  }}\n                  className={`p-1 border-2 text-left overflow-hidden transition-all ${\n                    imagePreview === sample.url\n                      ? \'border-[#141414] bg-[#141414] text-white\'\n                      : \'border-[#141414] hover:bg-[#F9F9F9] text-[#141414]\'\n                  }`}\n                >\n                  <img src={sample.url} alt={sample.name} className=\"w-full h-12 object-cover border border-[#141414] bg-white mb-1\" />\n                  <span className=\"text-[8px] font-bold block truncate\">{sample.name}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Custom File Upload Box */}\n          <div className=\"relative border-2 border-dashed border-[#141414] hover:bg-[#F9F9F9] bg-white p-4 text-center cursor-pointer transition-colors\">\n            <input\n              type=\"file\"\n              accept=\"image/*\"\n              onChange={handleFileUpload}\n              className=\"absolute inset-0 opacity-0 cursor-pointer\"\n            />\n            <Camera className=\"w-6 h-6 text-[#141414] mx-auto mb-2\" />\n            <span className=\"text-[10px] font-bold text-[#141414] block\">Click to upload custom photo</span>\n            <span className=\"text-[9px] text-[#141414]/70 font-bold block mt-1\">JPG, PNG, WEBP</span>\n          </div>\n\n          {/* Crop Context Input */}\n          <div className=\"space-y-1\">\n            <label className=\"text-[10px] text-[#141414] font-bold\">Crop Context:</label>\n            <input\n              type=\"text\"\n              value={cropContext}\n              onChange={(e) => setCropContext(e.target.value)}\n              placeholder=\"e.g. Winter Wheat, Roma Tomato\"\n              className=\"w-full bg-white border-2 border-[#141414] px-2 py-1.5 text-xs text-[#141414] font-bold focus:outline-none focus:bg-[#F9F9F9] placeholder-[#141414]/40\"\n            />\n          </div>\n\n          {/* Preview & Run Button */}\n          {imagePreview && (\n            <div className=\"space-y-3 pt-4 border-t-2 border-[#141414]\">\n              <div className=\"relative border-2 border-[#141414] bg-[#E4E3E0] max-h-48 overflow-hidden\">\n                <img src={imagePreview} alt=\"Selected Crop\" className=\"w-full h-48 object-cover mix-blend-multiply opacity-90\" />\n              </div>\n\n              <button\n                onClick={handleRunAnalysis}\n                disabled={isAnalyzing}\n                className=\"w-full py-2 border-2 border-[#141414] bg-[#141414] hover:bg-white text-white hover:text-[#141414] font-bold text-[10px] flex items-center justify-center space-x-2 transition-all disabled:opacity-50\"\n              >\n                {isAnalyzing ? (\n                  <>\n                    <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                    <span>Analyzing...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-3.5 h-3.5\" />\n                    <span>Run Gemini AI Vision Scan</span>\n                  </>\n                )}\n              </button>\n            </div>\n          )}\n\n          {errorMessage && (\n            <div className=\"p-2 bg-red-100 border-2 border-red-600 text-red-600 font-bold text-[10px] flex items-center space-x-2\">\n              <AlertTriangle className=\"w-3.5 h-3.5 shrink-0\" />\n              <span>{errorMessage}</span>\n            </div>\n          )}\n        </div>\n\n        {/* AI Extracted 6-Parameter Results (7 Cols) */}\n        <div className=\"lg:col-span-7 bg-white border-2 border-[#141414] p-4 space-y-4\">\n          <div className=\"flex items-center justify-between pb-2 border-b-2 border-[#141414]\">\n            <h3 className=\"text-sm font-bold text-[#141414] flex items-center space-x-2\">\n              <Sparkles className=\"w-4 h-4 text-[#141414]\" />\n              <span>Extracted Twin Parameters</span>\n            </h3>\n            {analysisResult && (\n              <button\n                onClick={handleSyncToTwin}\n                className=\"px-2 py-1 bg-white border-2 border-[#141414] text-[#141414] font-bold text-[10px] flex items-center space-x-1 hover:bg-[#141414] hover:text-white transition-all\"\n              >\n                <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                <span>Sync to Twin</span>\n              </button>\n            )}\n          </div>\n\n          {!analysisResult ? (\n            <div className=\"py-12 text-center space-y-3\">\n              <div className=\"w-10 h-10 border-2 border-[#141414] bg-[#F9F9F9] flex items-center justify-center mx-auto text-[#141414]\">\n                <Camera className=\"w-5 h-5\" />\n              </div>\n              <p className=\"text-[10px] font-bold text-[#141414]/70 max-w-sm mx-auto\">\n                Select an image on the left and run analysis to extract parameters automatically.\n              </p>\n            </div>\n          ) : (\n            <div className=\"space-y-4\">\n              {/* Confidence badge */}\n              <div className=\"flex items-center justify-between text-[10px] bg-[#F9F9F9] p-2 border-2 border-[#141414]\">\n                <span className=\"text-[#141414] font-bold\">AI Confidence Score:</span>\n                <span className=\"font-bold text-[#141414]\">{(analysisResult.confidenceScore * 100).toFixed(0)}%</span>\n              </div>\n\n              {/* 6 Parameter Output Grid */}\n              <div className=\"grid grid-cols-2 gap-3\">\n                {/* 1. Height */}\n                <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-[10px] font-bold text-[#141414]\">\n                    <Ruler className=\"w-3 h-3\" />\n                    <span>1. Height Estimate</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-[#141414]\">{analysisResult.plantHeightEstimateCm} cm</div>\n                </div>\n\n                {/* 2. Canopy */}\n                <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-[10px] font-bold text-[#141414]\">\n                    <Maximize className=\"w-3 h-3\" />\n                    <span>2. Canopy Coverage</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-[#141414]\">{analysisResult.canopyCoveragePercent}%</div>\n                </div>\n\n                {/* 3. Growth Stage */}\n                <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-[10px] font-bold text-[#141414]\">\n                    <TrendingUp className=\"w-3 h-3\" />\n                    <span>3. Growth Stage</span>\n                  </div>\n                  <div className=\"text-xs font-bold text-[#141414] truncate\">{analysisResult.growthStage}</div>\n                </div>\n\n                {/* 4. Disease */}\n                <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-[10px] font-bold text-[#141414]\">\n                    <ShieldAlert className=\"w-3 h-3\" />\n                    <span>4. Health / Disease</span>\n                  </div>\n                  <div className=\"text-[10px] font-bold text-red-600 truncate\">\n                    {analysisResult.healthAssessment.diseaseName} ({analysisResult.healthAssessment.riskScore}%)\n                  </div>\n                </div>\n\n                {/* 5. Ripeness */}\n                <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-[10px] font-bold text-[#141414]\">\n                    <Apple className=\"w-3 h-3\" />\n                    <span>5. Fruit Ripeness</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-[#141414]\">{analysisResult.fruitRipeness.ripenessPercent}%</div>\n                </div>\n\n                {/* 6. Yield */}\n                <div className=\"p-3 bg-[#E4E3E0] border-2 border-[#141414] space-y-1\">\n                  <div className=\"flex items-center space-x-1.5 text-[10px] font-bold text-[#141414]\">\n                    <Sprout className=\"w-3 h-3\" />\n                    <span>6. Yield Estimate</span>\n                  </div>\n                  <div className=\"text-sm font-bold text-[#141414]\">{analysisResult.yieldProjectionKgPerM2} kg/m\302\262</div>\n                </div>\n              </div>\n\n              {/* Recommended Action & Key Observations */}\n              <div className=\"p-3 border-2 border-[#141414] bg-white space-y-2 text-[10px] font-bold\">\n                <span className=\"text-[#141414] block border-b border-[#141414] pb-1\">AI Treatment Recommendation:</span>\n                <p className=\"text-[#141414]/80 leading-relaxed uppercase\">{analysisResult.healthAssessment.recommendedAction}</p>\n\n                {analysisResult.keyObservations?.length > 0 && (\n                  <div className=\"pt-2 border-t-2 border-[#141414]\">\n                    <span className=\"text-[#141414] block mb-1\">Key Observations:</span>\n                    <ul className=\"list-disc list-inside space-y-0.5 text-[#141414]/80 uppercase\">\n                      {analysisResult.keyObservations.map((obs, idx) => (\n                        <li key={idx}>{obs}</li>\n                      ))}\n                    </ul>\n                  </div>\n                )}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>"
      }
      num_matches: 1
    }
  }
}
