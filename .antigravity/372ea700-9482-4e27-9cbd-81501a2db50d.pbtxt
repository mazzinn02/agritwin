          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const ripeness = day < 35 ? 0 : Math.min(100, Math.pow((day - 35) / 55, 1.5) * twinState.fruitRipenessPercent * 1.1);"
