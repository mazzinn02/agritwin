      replacement_content: "    <div className=\"space-y-6\">\n      <div className=\"bg-white border-2 border-[#141414] p-4 font-mono uppercase\">\n        <div className=\"flex items-center justify-between mb-2 border-b-2 border-[#141414] pb-2\">\n          <div className=\"flex items-center space-x-2\">\n            <BarChart3 className=\"w-5 h-5 text-[#141414]\" />\n            <h2 className=\"text-base font-bold text-[#141414]\">6-Parameter Time Series Telemetry</h2>\n          </div>\n          <span className=\"text-[10px] font-bold text-white bg-[#141414] px-1.5 py-0.5\">\n            Season Tracking: Day 1 to Day {twinState.currentDay}\n          </span>\n        </div>\n        <p className=\"text-[10px] text-[#141414]/80 font-bold max-w-3xl\">\n          Digital Twin biometric progression curves comparing plant height, leaf canopy coverage, health risk index, ripeness curve, and predicted harvest yield.\n        </p>\n      </div>\n\n      {/* Row 1: Plant Height & Canopy Coverage Charts */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Chart 1: Height (Parameter 1) */}\n        <div className=\"bg-white border-2 border-[#141414] p-4 space-y-4 uppercase font-mono\">\n          <div className=\"flex items-center justify-between border-b-2 border-[#141414] pb-2\">\n            <h3 className=\"text-sm font-bold text-[#141414] flex items-center space-x-2\">\n              <span className=\"w-2.5 h-2.5 bg-emerald-500 border border-[#141414]\" />\n              <span>Plant Height (cm)</span>\n            </h3>\n            <span className=\"text-xs font-bold\">{twinState.plantHeightCm.toFixed(1)} cm</span>\n          </div>\n\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={chartData}>\n                <defs>\n                  <linearGradient id=\"heightGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#10b981\" stopOpacity={0.8} />\n                    <stop offset=\"95%\" stopColor=\"#10b981\" stopOpacity={0.0} />\n                  </linearGradient>\n                </defs>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#141414\" opacity={0.2} />\n                <XAxis dataKey=\"day\" stroke=\"#141414\" fontSize={10} tick={{ fill: \'#141414\', fontWeight: \'bold\' }} />\n                <YAxis stroke=\"#141414\" fontSize={10} tick={{ fill: \'#141414\', fontWeight: \'bold\' }} unit=\"cm\" />\n                <Tooltip\n                  contentStyle={{ backgroundColor: \'#fff\', borderColor: \'#141414\', borderWidth: \'2px\', borderRadius: \'0\', fontSize: \'10px\', fontWeight: \'bold\', textTransform: \'uppercase\' }}\n                  itemStyle={{ color: \'#141414\' }}\n                />\n                <Area type=\"step\" dataKey=\"height\" stroke=\"#141414\" strokeWidth={2} fillOpacity={1} fill=\"url(#heightGrad)\" />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Chart 2: Canopy Coverage (Parameter 2) */}\n        <div className=\"bg-white border-2 border-[#141414] p-4 space-y-4 uppercase font-mono\">\n          <div className=\"flex items-center justify-between border-b-2 border-[#141414] pb-2\">\n            <h3 className=\"text-sm font-bold text-[#141414] flex items-center space-x-2\">\n              <span className=\"w-2.5 h-2.5 bg-lime-500 border border-[#141414]\" />\n              <span>Canopy Coverage (%)</span>\n            </h3>\n            <span className=\"text-xs font-bold\">{twinState.canopyCoveragePercent.toFixed(1)}%</span>\n          </div>\n\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={chartData}>\n                <defs>\n                  <linearGradient id=\"canopyGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#84cc16\" stopOpacity={0.8} />\n                    <stop offset=\"95%\" stopColor=\"#84cc16\" stopOpacity={0.0} />\n                  </linearGradient>\n                </defs>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#141414\" opacity={0.2} />\n                <XAxis dataKey=\"day\" stroke=\"#141414\" fontSize={10} tick={{ fill: \'#141414\', fontWeight: \'bold\' }} />\n                <YAxis stroke=\"#141414\" fontSize={10} tick={{ fill: \'#141414\', fontWeight: \'bold\' }} unit=\"%\" />\n                <Tooltip\n                  contentStyle={{ backgroundColor: \'#fff\', borderColor: \'#141414\', borderWidth: \'2px\', borderRadius: \'0\', fontSize: \'10px\', fontWeight: \'bold\', textTransform: \'uppercase\' }}\n                  itemStyle={{ color: \'#141414\' }}\n                />\n                <Area type=\"step\" dataKey=\"canopy\" stroke=\"#141414\" strokeWidth={2} fillOpacity={1} fill=\"url(#canopyGrad)\" />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n      </div>\n\n      {/* Row 2: Disease Risk & Yield Forecasting */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Chart 3: Disease Risk (Parameter 4) */}\n        <div className=\"bg-white border-2 border-[#141414] p-4 space-y-4 uppercase font-mono\">\n          <div className=\"flex items-center justify-between border-b-2 border-[#141414] pb-2\">\n            <h3 className=\"text-sm font-bold text-[#141414] flex items-center space-x-2\">\n              <span className=\"w-2.5 h-2.5 bg-red-500 border border-[#141414]\" />\n              <span>Pathogen Vulnerability (%)</span>\n            </h3>\n            <span className=\"text-xs font-bold text-red-600\">{twinState.diseaseRiskPercent.toFixed(1)}% Risk</span>\n          </div>\n\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <LineChart data={chartData}>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#141414\" opacity={0.2} />\n                <XAxis dataKey=\"day\" stroke=\"#141414\" fontSize={10} tick={{ fill: \'#141414\', fontWeight: \'bold\' }} />\n                <YAxis stroke=\"#141414\" fontSize={10} tick={{ fill: \'#141414\', fontWeight: \'bold\' }} unit=\"%\" />\n                <Tooltip\n                  contentStyle={{ backgroundColor: \'#fff\', borderColor: \'#141414\', borderWidth: \'2px\', borderRadius: \'0\', fontSize: \'10px\', fontWeight: \'bold\', textTransform: \'uppercase\' }}\n                  itemStyle={{ color: \'#141414\' }}\n                />\n                <Line type=\"step\" dataKey=\"disease\" stroke=\"#ef4444\" strokeWidth={3} dot={{ fill: \'#141414\', stroke: \'#141414\', strokeWidth: 2, r: 4 }} />\n              </LineChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Chart 4: Yield Estimation (Parameter 6) */}\n        <div className=\"bg-white border-2 border-[#141414] p-4 space-y-4 uppercase font-mono\">\n          <div className=\"flex items-center justify-between border-b-2 border-[#141414] pb-2\">\n            <h3 className=\"text-sm font-bold text-[#141414] flex items-center space-x-2\">\n              <span className=\"w-2.5 h-2.5 bg-purple-500 border border-[#141414]\" />\n              <span>Projected Harvest (kg/m\302\262)</span>\n            </h3>\n            <span className=\"text-xs font-bold\">{twinState.estimatedYieldKgPerM2.toFixed(1)} kg/m\302\262</span>\n          </div>\n\n          <div className=\"h-64 w-full\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <BarChart data={chartData}>\n                <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#141414\" opacity={0.2} />\n                <XAxis dataKey=\"day\" stroke=\"#141414\" fontSize={10} tick={{ fill: \'#141414\', fontWeight: \'bold\' }} />\n                <YAxis stroke=\"#141414\" fontSize={10} tick={{ fill: \'#141414\', fontWeight: \'bold\' }} unit=\"kg\" />\n                <Tooltip\n                  contentStyle={{ backgroundColor: \'#fff\', borderColor: \'#141414\', borderWidth: \'2px\', borderRadius: \'0\', fontSize: \'10px\', fontWeight: \'bold\', textTransform: \'uppercase\' }}\n                  itemStyle={{ color: \'#141414\' }}\n                  cursor={{ fill: \'#141414\', opacity: 0.1 }}\n                />\n                <Bar dataKey=\"yieldVal\" fill=\"#8b5cf6\" stroke=\"#141414\" strokeWidth={2} radius={0} />\n              </BarChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n      </div>\n    </div>"
