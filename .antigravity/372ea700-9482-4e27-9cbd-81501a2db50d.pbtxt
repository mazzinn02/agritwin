    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    <div className=\"space-y-6\">\n      {/* Top Twin Summary Cards */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3\">\n        {PARAMETER_METADATA.map((param) => {\n          let val = 0;\n          let format = \'\';\n          if (param.id === \'height\') { val = twinState.plantHeightCm; format = `${val.toFixed(1)} cm`; }\n          else if (param.id === \'canopy\') { val = twinState.canopyCoveragePercent; format = `${val.toFixed(1)}%`; }\n          else if (param.id === \'growth\') { val = twinState.growthRateCmPerDay; format = `+${val.toFixed(1)} cm/d`; }\n          else if (param.id === \'disease\') { val = twinState.diseaseRiskPercent; format = `${val.toFixed(1)}% risk`; }\n          else if (param.id === \'ripeness\') { val = twinState.fruitRipenessPercent; format = `${val.toFixed(1)}% ripe`; }\n          else if (param.id === \'yield\') { val = twinState.estimatedYieldKgPerM2; format = `${val.toFixed(1)} kg/m\302\262`; }\n\n          return (\n            <div\n              key={param.id}\n              onClick={() => setActiveOverlay(param.id as any)}\n              className={`p-3.5 rounded-xl border transition-all cursor-pointer relative overflow-hidden ${\n                activeOverlay === param.id\n                  ? \'bg-slate-800/90 border-emerald-500 shadow-lg shadow-emerald-500/10 ring-1 ring-emerald-500/30\'\n                  : \'bg-slate-900/80 border-slate-800 hover:border-slate-700 hover:bg-slate-800/50\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"text-[11px] font-medium text-slate-400 truncate\">{param.name.replace(\' Detection\', \'\')}</span>\n                <div\n                  className=\"w-2 h-2 rounded-full\"\n                  style={{ backgroundColor: param.color }}\n                />\n              </div>\n              <div className=\"text-lg font-bold text-slate-100 tracking-tight\">{format}</div>\n              <p className=\"text-[10px] text-slate-400 mt-1 line-clamp-1\">{param.description}</p>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Main Canvas & Live Controls Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Interactive Digital Twin Render Stage (8 Cols) */}\n        <div className=\"lg:col-span-8 bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl relative overflow-hidden\">\n          {/* Header Controls for Canvas */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-800\">\n            <div className=\"flex items-center space-x-2\">\n              <Layers className=\"w-5 h-5 text-emerald-400\" />\n              <h2 className=\"text-sm font-semibold text-slate-200\">\n                Interactive Crop Twin Simulation Stage\n              </h2>\n              <span className=\"text-xs px-2 py-0.5 rounded bg-slate-800 text-slate-400 font-mono\">\n                {twinState.cropType} \342\200\242 Stage: {twinState.stage}\n              </span>\n            </div>\n\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-xs text-slate-400\">View Overlay:</span>\n              {([\'all\', \'height\', \'canopy\', \'disease\', \'ripeness\'] as const).map((mode) => (\n                <button\n                  key={mode}\n                  onClick={() => setActiveOverlay(mode)}\n                  className={`px-2.5 py-1 text-[11px] font-medium rounded-md capitalize transition-colors ${\n                    activeOverlay === mode\n                      ? \'bg-emerald-500 text-slate-950 font-bold\'\n                      : \'bg-slate-800 text-slate-400 hover:text-slate-200\'\n                  }`}\n                >\n                  {mode}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Graphical Crop Field Visualization Stage */}\n          <div className=\"relative w-full h-[400px] bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 rounded-xl border border-slate-800 overflow-hidden flex items-center justify-center\">\n            {/* Field Grid Pattern */}\n            <div \n              className=\"absolute inset-0 opacity-15 pointer-events-none\"\n              style={{\n                backgroundImage: `radial-gradient(#10b981 1px, transparent 1px)`,\n                backgroundSize: \'24px 24px\',\n              }}\n            />\n\n            {/* IoT Sensor Pulse Node */}\n            <div className=\"absolute top-6 left-6 flex items-center space-x-2 bg-slate-900/80 border border-slate-700/80 px-3 py-1.5 rounded-lg text-xs\">\n              <Radio className=\"w-4 h-4 text-emerald-400 animate-pulse\" />\n              <div>\n                <div className=\"font-semibold text-slate-200\">{twinState.sensors.id}</div>\n                <div className=\"text-[10px] text-slate-400\">{twinState.sensors.name}</div>\n              </div>\n            </div>\n\n            {/* Health Index Meter Overlay */}\n            <div className=\"absolute top-6 right-6 bg-slate-900/80 border border-slate-700/80 p-3 rounded-lg text-right\">\n              <div className=\"text-[10px] text-slate-400 font-medium uppercase tracking-wider\">Twin Health Index</div>\n              <div className=\"text-2xl font-bold text-emerald-400\">{twinState.healthScore}%</div>\n            </div>\n\n            {/* Simulated Plants Row in Canvas */}\n            <div className=\"relative z-10 flex items-end justify-center space-x-6 w-full max-w-xl px-4\">\n              {[0, 1, 2, 3, 4].map((idx) => {\n                // Height calculation scaled for visualization\n                const plantHeightPx = Math.min(260, Math.max(60, twinState.plantHeightCm * 1.8));\n                const canopyWidthPx = Math.min(140, Math.max(50, twinState.canopyCoveragePercent * 1.4));\n                const ripenessColor = getRipenessColor(twinState.fruitRipenessPercent);\n\n                return (\n                  <div key={idx} className=\"flex flex-col items-center group relative\">\n                    {/* Plant Height Annotation */}\n                    {(activeOverlay === \'all\' || activeOverlay === \'height\') && idx === 2 && (\n                      <div className=\"absolute -top-8 bg-emerald-950/90 border border-emerald-500/50 text-emerald-300 px-2 py-0.5 rounded text-[10px] font-mono whitespace-nowrap animate-bounce\">\n                        Height: {twinState.plantHeightCm.toFixed(1)} cm\n                      </div>\n                    )}\n\n                    {/* Disease Alert Highlight */}\n                    {(activeOverlay === \'all\' || activeOverlay === \'disease\') && twinState.diseaseRiskPercent > 12 && idx === 1 && (\n                      <div className=\"absolute -top-10 bg-red-950/90 border border-red-500/80 text-red-300 px-2 py-0.5 rounded text-[10px] font-semibold flex items-center space-x-1 animate-pulse\">\n                        <ShieldAlert className=\"w-3 h-3 text-red-400\" />\n                        <span>Fungal Spot Risk ({twinState.diseaseRiskPercent}%)</span>\n                      </div>\n                    )}\n\n                    {/* Plant SVG Structure */}\n                    <div \n                      className=\"relative flex items-end justify-center transition-all duration-500\"\n                      style={{ height: `${plantHeightPx}px` }}\n                    >\n                      {/* Main Stem */}\n                      <div className=\"w-2.5 bg-gradient-to-t from-emerald-800 to-emerald-500 rounded-full h-full shadow-lg\" />\n\n                      {/* Leaves Canopy Layer */}\n                      <div \n                        className=\"absolute bottom-1/3 rounded-full bg-emerald-500/30 border border-emerald-400/50 transition-all duration-500 blur-[0.5px]\"\n                        style={{\n                          width: `${canopyWidthPx}px`,\n                          height: `${canopyWidthPx * 0.7}px`,\n                          opacity: activeOverlay === \'disease\' && twinState.diseaseRiskPercent > 20 ? 0.6 : 0.85,\n                        }}\n                      />\n\n                      {/* Leaves Detail */}\n                      <div className=\"absolute top-1/4 -left-6 w-8 h-4 bg-emerald-600 rounded-full transform -rotate-25 shadow-md\" />\n                      <div className=\"absolute top-1/4 -right-6 w-8 h-4 bg-emerald-600 rounded-full transform rotate-25 shadow-md\" />\n                      <div className=\"absolute top-2/4 -left-8 w-10 h-5 bg-emerald-500 rounded-full transform -rotate-15 shadow-md\" />\n                      <div className=\"absolute top-2/4 -right-8 w-10 h-5 bg-emerald-500 rounded-full transform rotate-15 shadow-md\" />\n\n                      {/* Fruit/Grain Pods with Ripeness Indicator */}\n                      <div \n                        className=\"absolute top-1/6 w-4 h-4 rounded-full border border-slate-900 shadow-md transition-all duration-500 flex items-center justify-center\"\n                        style={{ backgroundColor: ripenessColor }}\n                      >\n                        <div className=\"w-1.5 h-1.5 rounded-full bg-white/60\" />\n                      </div>\n                    </div>\n\n                    {/* Ground Root Base & Soil Marker */}\n                    <div className=\"w-20 h-2 bg-amber-900/80 rounded-full mt-1 border border-amber-800/50\" />\n                  </div>\n                );\n              })}\n            </div>\n\n            {/* Bottom Parameter Legend bar on Canvas */}\n            <div className=\"absolute bottom-4 inset-x-6 bg-slate-900/90 backdrop-blur-md border border-slate-800 rounded-xl px-4 py-2 flex flex-wrap items-center justify-between text-xs text-slate-300\">\n              <div className=\"flex items-center space-x-4\">\n                <span className=\"flex items-center space-x-1\">\n                  <Ruler className=\"w-3.5 h-3.5 text-emerald-400\" />\n                  <span>Height: <b>{twinState.plantHeightCm.toFixed(1)}cm</b></span>\n                </span>\n                <span className=\"flex items-center space-x-1\">\n                  <Maximize className=\"w-3.5 h-3.5 text-lime-400\" />\n                  <span>Canopy: <b>{twinState.canopyCoveragePercent.toFixed(1)}%</b></span>\n                </span>\n                <span className=\"flex items-center space-x-1\">\n                  <Apple className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span>Ripeness: <b>{twinState.fruitRipenessPercent.toFixed(1)}%</b></span>\n                </span>\n              </div>\n              <div className=\"text-slate-400 font-mono text-[11px]\">\n                Yield Est: <b className=\"text-purple-400\">{twinState.estimatedYieldKgPerM2.toFixed(1)} kg/m\302\262</b>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Live Environmental Control & Sensor Suite (4 Cols) */}\n        <div className=\"lg:col-span-4 space-y-4\">\n          {/* Environment Actuator Card */}\n          <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-4\">\n            <div className=\"flex items-center justify-between pb-2 border-b border-slate-800\">\n              <div className=\"flex items-center space-x-2\">\n                <Activity className=\"w-4 h-4 text-cyan-400\" />\n                <h3 className=\"text-sm font-semibold text-slate-200\">Twin Climate Control</h3>\n              </div>\n              <span className=\"text-[10px] bg-cyan-950 text-cyan-300 px-2 py-0.5 rounded border border-cyan-500/30\">\n                Interactive Simulator\n              </span>\n            </div>\n\n            {/* Temperature Slider */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex justify-between text-xs\">\n                <span className=\"text-slate-400 flex items-center space-x-1\">\n                  <Thermometer className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span>Air Temperature</span>\n                </span>\n                <span className=\"font-semibold text-slate-200\">{twinState.sensors.temperature}\302\260C</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"10\"\n                max=\"42\"\n                value={twinState.sensors.temperature}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, temperature: parseFloat(e.target.value) },\n                  })\n                }\n                className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-500\"\n              />\n            </div>\n\n            {/* Humidity Slider */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex justify-between text-xs\">\n                <span className=\"text-slate-400 flex items-center space-x-1\">\n                  <Droplets className=\"w-3.5 h-3.5 text-blue-400\" />\n                  <span>Relative Humidity</span>\n                </span>\n                <span className=\"font-semibold text-slate-200\">{twinState.sensors.humidity}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"20\"\n                max=\"95\"\n                value={twinState.sensors.humidity}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, humidity: parseInt(e.target.value, 10) },\n                  })\n                }\n                className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-blue-500\"\n              />\n            </div>\n\n            {/* Soil Moisture Slider */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex justify-between text-xs\">\n                <span className=\"text-slate-400 flex items-center space-x-1\">\n                  <CloudRain className=\"w-3.5 h-3.5 text-teal-400\" />\n                  <span>Soil Moisture</span>\n                </span>\n                <span className=\"font-semibold text-slate-200\">{twinState.sensors.soilMoisture}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"10\"\n                max=\"90\"\n                value={twinState.sensors.soilMoisture}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, soilMoisture: parseInt(e.target.value, 10) },\n                  })\n                }\n                className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-teal-500\"\n              />\n            </div>\n\n            {/* Quick Action Button: Simulate Smart Irrigation */}\n            <button\n              onClick={handleSimulateIrrigation}\n              disabled={isSimulatingIrrigation}\n              className=\"w-full py-2.5 px-4 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-slate-950 font-semibold rounded-xl text-xs flex items-center justify-center space-x-2 shadow-lg shadow-emerald-500/20 transition-all disabled:opacity-50\"\n            >\n              {isSimulatingIrrigation ? (\n                <>\n                  <Sparkles className=\"w-4 h-4 animate-spin\" />\n                  <span>Triggering Smart Drip Irrigation...</span>\n                </>\n              ) : (\n                <>\n                  <CloudRain className=\"w-4 h-4\" />\n                  <span>Trigger Smart Drip Irrigation</span>\n                </>\n              )}\n            </button>\n          </div>\n\n          {/* College Project Architecture Quick Callout */}\n          <div className=\"bg-slate-900/90 rounded-2xl border border-slate-800 p-5 shadow-xl space-y-2\">\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center space-x-1.5\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n              <span>Project Implementation Core</span>\n            </h4>\n            <p className=\"text-xs text-slate-300 leading-relaxed\">\n              This Digital Twin synchronizes physical IoT sensor streams with virtual crop state machines. The 6 key parameters (Height, Canopy, Growth, Disease, Ripeness, Yield) drive real-time farm decision support.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>"
      replacement_content: "    <div className=\"space-y-6\">\n      {/* Top Twin Summary Cards */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3\">\n        {PARAMETER_METADATA.map((param) => {\n          let val = 0;\n          let format = \'\';\n          if (param.id === \'height\') { val = twinState.plantHeightCm; format = `${val.toFixed(1)} cm`; }\n          else if (param.id === \'canopy\') { val = twinState.canopyCoveragePercent; format = `${val.toFixed(1)}%`; }\n          else if (param.id === \'growth\') { val = twinState.growthRateCmPerDay; format = `+${val.toFixed(1)} cm/d`; }\n          else if (param.id === \'disease\') { val = twinState.diseaseRiskPercent; format = `${val.toFixed(1)}% risk`; }\n          else if (param.id === \'ripeness\') { val = twinState.fruitRipenessPercent; format = `${val.toFixed(1)}% ripe`; }\n          else if (param.id === \'yield\') { val = twinState.estimatedYieldKgPerM2; format = `${val.toFixed(1)} kg/m\302\262`; }\n\n          return (\n            <div\n              key={param.id}\n              onClick={() => setActiveOverlay(param.id as any)}\n              className={`p-3 border-2 border-[#141414] transition-all cursor-pointer relative overflow-hidden uppercase font-mono ${\n                activeOverlay === param.id\n                  ? \'bg-[#141414] text-[#E4E3E0]\'\n                  : \'bg-white text-[#141414] hover:bg-[#F9F9F9]\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"text-[10px] font-bold truncate\">{param.name.replace(\' Detection\', \'\')}</span>\n                <div\n                  className=\"w-2 h-2 rounded-full\"\n                  style={{ backgroundColor: param.color }}\n                />\n              </div>\n              <div className=\"text-lg font-bold tracking-tight\">{format}</div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Main Canvas & Live Controls Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Interactive Digital Twin Render Stage (8 Cols) */}\n        <div className=\"lg:col-span-8 bg-white border-2 border-[#141414] p-4 relative overflow-hidden\">\n          {/* Header Controls for Canvas */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b-2 border-[#141414]\">\n            <div className=\"flex items-center space-x-2\">\n              <Layers className=\"w-5 h-5 text-[#141414]\" />\n              <h2 className=\"text-sm font-bold uppercase text-[#141414]\">\n                Twin Simulation Stage\n              </h2>\n              <span className=\"text-[10px] px-1.5 py-0.5 bg-[#141414] text-white font-mono uppercase font-bold\">\n                {twinState.cropType} \342\200\242 Stage: {twinState.stage}\n              </span>\n            </div>\n\n            <div className=\"flex items-center space-x-2 font-mono text-[10px] uppercase font-bold\">\n              <span className=\"text-[#141414]\">Overlay:</span>\n              {([\'all\', \'height\', \'canopy\', \'disease\', \'ripeness\'] as const).map((mode) => (\n                <button\n                  key={mode}\n                  onClick={() => setActiveOverlay(mode)}\n                  className={`px-2 py-1 border border-[#141414] transition-colors ${\n                    activeOverlay === mode\n                      ? \'bg-[#141414] text-white\'\n                      : \'bg-white text-[#141414] hover:bg-[#F9F9F9]\'\n                  }`}\n                >\n                  {mode}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Graphical Crop Field Visualization Stage */}\n          <div className=\"relative w-full h-[400px] bg-[#E4E3E0] border-2 border-[#141414] overflow-hidden flex items-center justify-center\">\n            {/* Field Grid Pattern */}\n            <div \n              className=\"absolute inset-0 opacity-20 pointer-events-none\"\n              style={{\n                backgroundImage: `radial-gradient(#141414 1px, transparent 1px)`,\n                backgroundSize: \'24px 24px\',\n              }}\n            />\n\n            {/* IoT Sensor Pulse Node */}\n            <div className=\"absolute top-4 left-4 flex items-center space-x-2 bg-white border-2 border-[#141414] px-2 py-1 font-mono uppercase\">\n              <Radio className=\"w-3.5 h-3.5 text-[#141414] animate-pulse\" />\n              <div>\n                <div className=\"font-bold text-[#141414] text-xs\">{twinState.sensors.id}</div>\n                <div className=\"text-[9px] text-[#141414]/70 font-bold\">{twinState.sensors.name}</div>\n              </div>\n            </div>\n\n            {/* Health Index Meter Overlay */}\n            <div className=\"absolute top-4 right-4 bg-[#141414] text-white border-2 border-[#141414] p-2 text-right uppercase font-mono\">\n              <div className=\"text-[9px] font-bold\">Twin Health Index</div>\n              <div className=\"text-xl font-bold\">{twinState.healthScore}%</div>\n            </div>\n\n            {/* Simulated Plants Row in Canvas */}\n            <div className=\"relative z-10 flex items-end justify-center space-x-6 w-full max-w-xl px-4\">\n              {[0, 1, 2, 3, 4].map((idx) => {\n                // Height calculation scaled for visualization\n                const plantHeightPx = Math.min(260, Math.max(60, twinState.plantHeightCm * 1.8));\n                const canopyWidthPx = Math.min(140, Math.max(50, twinState.canopyCoveragePercent * 1.4));\n                const ripenessColor = getRipenessColor(twinState.fruitRipenessPercent);\n\n                return (\n                  <div key={idx} className=\"flex flex-col items-center group relative\">\n                    {/* Plant Height Annotation */}\n                    {(activeOverlay === \'all\' || activeOverlay === \'height\') && idx === 2 && (\n                      <div className=\"absolute -top-8 bg-white border-2 border-[#141414] text-[#141414] px-1 py-0.5 text-[10px] font-bold uppercase font-mono whitespace-nowrap animate-bounce\">\n                        Height: {twinState.plantHeightCm.toFixed(1)} cm\n                      </div>\n                    )}\n\n                    {/* Disease Alert Highlight */}\n                    {(activeOverlay === \'all\' || activeOverlay === \'disease\') && twinState.diseaseRiskPercent > 12 && idx === 1 && (\n                      <div className=\"absolute -top-10 bg-white border-2 border-red-600 text-red-600 px-1 py-0.5 text-[10px] font-bold uppercase font-mono flex items-center space-x-1 animate-pulse\">\n                        <ShieldAlert className=\"w-3 h-3\" />\n                        <span>Fungal Spot Risk ({twinState.diseaseRiskPercent}%)</span>\n                      </div>\n                    )}\n\n                    {/* Plant SVG Structure */}\n                    <div \n                      className=\"relative flex items-end justify-center transition-all duration-500\"\n                      style={{ height: `${plantHeightPx}px` }}\n                    >\n                      {/* Main Stem */}\n                      <div className=\"w-2.5 bg-gradient-to-t from-emerald-800 to-emerald-500 border border-[#141414] h-full\" />\n\n                      {/* Leaves Canopy Layer */}\n                      <div \n                        className=\"absolute bottom-1/3 rounded-none bg-emerald-500 border-2 border-[#141414] transition-all duration-500\"\n                        style={{\n                          width: `${canopyWidthPx}px`,\n                          height: `${canopyWidthPx * 0.7}px`,\n                          opacity: activeOverlay === \'disease\' && twinState.diseaseRiskPercent > 20 ? 0.6 : 0.9,\n                        }}\n                      />\n\n                      {/* Leaves Detail */}\n                      <div className=\"absolute top-1/4 -left-6 w-8 h-4 bg-emerald-600 border border-[#141414] transform -rotate-25\" />\n                      <div className=\"absolute top-1/4 -right-6 w-8 h-4 bg-emerald-600 border border-[#141414] transform rotate-25\" />\n                      <div className=\"absolute top-2/4 -left-8 w-10 h-5 bg-emerald-500 border border-[#141414] transform -rotate-15\" />\n                      <div className=\"absolute top-2/4 -right-8 w-10 h-5 bg-emerald-500 border border-[#141414] transform rotate-15\" />\n\n                      {/* Fruit/Grain Pods with Ripeness Indicator */}\n                      <div \n                        className=\"absolute top-1/6 w-4 h-4 border-2 border-[#141414] transition-all duration-500 flex items-center justify-center\"\n                        style={{ backgroundColor: ripenessColor }}\n                      >\n                        <div className=\"w-1.5 h-1.5 bg-white\" />\n                      </div>\n                    </div>\n\n                    {/* Ground Root Base & Soil Marker */}\n                    <div className=\"w-20 h-2 bg-[#141414] mt-1\" />\n                  </div>\n                );\n              })}\n            </div>\n\n            {/* Bottom Parameter Legend bar on Canvas */}\n            <div className=\"absolute bottom-3 inset-x-4 bg-white border-2 border-[#141414] p-2 flex flex-wrap items-center justify-between text-[10px] uppercase font-bold font-mono text-[#141414]\">\n              <div className=\"flex items-center space-x-4\">\n                <span className=\"flex items-center space-x-1\">\n                  <Ruler className=\"w-3.5 h-3.5\" />\n                  <span>Height: {twinState.plantHeightCm.toFixed(1)}cm</span>\n                </span>\n                <span className=\"flex items-center space-x-1\">\n                  <Maximize className=\"w-3.5 h-3.5\" />\n                  <span>Canopy: {twinState.canopyCoveragePercent.toFixed(1)}%</span>\n                </span>\n                <span className=\"flex items-center space-x-1\">\n                  <Apple className=\"w-3.5 h-3.5\" />\n                  <span>Ripeness: {twinState.fruitRipenessPercent.toFixed(1)}%</span>\n                </span>\n              </div>\n              <div>\n                Yield Est: {twinState.estimatedYieldKgPerM2.toFixed(1)} kg/m\302\262\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Live Environmental Control & Sensor Suite (4 Cols) */}\n        <div className=\"lg:col-span-4 space-y-4\">\n          {/* Environment Actuator Card */}\n          <div className=\"bg-white border-2 border-[#141414] p-4 space-y-4\">\n            <div className=\"flex items-center justify-between pb-2 border-b-2 border-[#141414]\">\n              <div className=\"flex items-center space-x-2\">\n                <Activity className=\"w-4 h-4 text-[#141414]\" />\n                <h3 className=\"text-sm font-bold uppercase text-[#141414]\">Climate Control</h3>\n              </div>\n              <span className=\"text-[9px] bg-[#141414] text-white px-1.5 py-0.5 uppercase font-bold font-mono\">\n                Interactive\n              </span>\n            </div>\n\n            {/* Temperature Slider */}\n            <div className=\"space-y-1 font-mono uppercase font-bold text-xs text-[#141414]\">\n              <div className=\"flex justify-between\">\n                <span className=\"flex items-center space-x-1\">\n                  <Thermometer className=\"w-3.5 h-3.5\" />\n                  <span>Air Temp</span>\n                </span>\n                <span>{twinState.sensors.temperature}\302\260C</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"10\"\n                max=\"42\"\n                value={twinState.sensors.temperature}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, temperature: parseFloat(e.target.value) },\n                  })\n                }\n                className=\"w-full h-1.5 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n              />\n            </div>\n\n            {/* Humidity Slider */}\n            <div className=\"space-y-1 font-mono uppercase font-bold text-xs text-[#141414]\">\n              <div className=\"flex justify-between\">\n                <span className=\"flex items-center space-x-1\">\n                  <Droplets className=\"w-3.5 h-3.5\" />\n                  <span>Humidity</span>\n                </span>\n                <span>{twinState.sensors.humidity}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"20\"\n                max=\"95\"\n                value={twinState.sensors.humidity}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, humidity: parseInt(e.target.value, 10) },\n                  })\n                }\n                className=\"w-full h-1.5 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n              />\n            </div>\n\n            {/* Soil Moisture Slider */}\n            <div className=\"space-y-1 font-mono uppercase font-bold text-xs text-[#141414]\">\n              <div className=\"flex justify-between\">\n                <span className=\"flex items-center space-x-1\">\n                  <CloudRain className=\"w-3.5 h-3.5\" />\n                  <span>Moisture</span>\n                </span>\n                <span>{twinState.sensors.soilMoisture}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"10\"\n                max=\"90\"\n                value={twinState.sensors.soilMoisture}\n                onChange={(e) =>\n                  onStateChange({\n                    sensors: { ...twinState.sensors, soilMoisture: parseInt(e.target.value, 10) },\n                  })\n                }\n                className=\"w-full h-1.5 bg-[#E4E3E0] border border-[#141414] appearance-none cursor-pointer accent-[#141414]\"\n              />\n            </div>\n\n            {/* Quick Action Button: Simulate Smart Irrigation */}\n            <button\n              onClick={handleSimulateIrrigation}\n              disabled={isSimulatingIrrigation}\n              className=\"w-full py-2 bg-[#141414] hover:bg-[#141414]/90 text-white font-bold font-mono uppercase text-[10px] flex items-center justify-center space-x-2 transition-all disabled:opacity-50\"\n            >\n              {isSimulatingIrrigation ? (\n                <>\n                  <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n                  <span>Triggering Drip Irrigation...</span>\n                </>\n              ) : (\n                <>\n                  <CloudRain className=\"w-3.5 h-3.5\" />\n                  <span>Trigger Drip Irrigation</span>\n                </>\n              )}\n            </button>\n          </div>\n\n          {/* College Project Architecture Quick Callout */}\n          <div className=\"bg-[#E4E3E0] border-2 border-[#141414] p-4 space-y-2\">\n            <h4 className=\"text-[10px] font-bold uppercase tracking-wider text-[#141414] flex items-center space-x-1.5 font-mono\">\n              <Sparkles className=\"w-3 h-3\" />\n              <span>Project Core</span>\n            </h4>\n            <p className=\"text-[10px] text-[#141414] leading-relaxed font-mono uppercase font-bold\">\n              This Digital Twin synchronizes physical IoT sensor streams with virtual crop state machines. The 6 key parameters drive real-time farm decision support.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>"
