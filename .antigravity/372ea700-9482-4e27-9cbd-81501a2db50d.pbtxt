         </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Day Scrubber */}\n            <div className=\"flex items-center space-x-3 bg-white px-2 py-1 border border-[#141414]\">\n              <div className=\"flex items-center space-x-1\">\n                <Calendar className=\"w-3.5 h-3.5\" />\n                <span>Day {twinState.currentDay.toString().padStart(2, \'0\')}/90</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"1\"\n                max=\"90\"\n                value={twinState.currentDay}\n                onChange={(e) => onDayChange(parseInt(e.target.value, 10))}\n                className=\"w-20 h-1 bg-[#141414] appearance-none cursor-pointer\"\n              />\n            </div>\n\n            {/* IoT Sync Status */}\n            <div className=\"flex items-center space-x-2 bg-[#141414] text-white px-2 py-1\">\n              <span className=\"relative flex h-2 w-2\">\n                <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#E4E3E0] opacity-75\"></span>\n                <span className=\"relative inline-flex rounded-full h-2 w-2 bg-[#E4E3E0]\"></span>\n              </span>\n              <Wifi className=\"w-3.5 h-3.5\" />\n              <span>Telemetry Synced</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Navigation Tabs */}\n        <div className=\"flex space-x-0 overflow-x-auto border-t-2 border-[#141414] font-mono text-xs uppercase font-bold\">\n          <button\n            onClick={() => onSelectView(\'twin\')}\n            className={`flex items-center space-x-2 px-3 py-2 border-r-2 border-[#141414] transition-colors whitespace-nowrap ${\n              currentView === \'twin\'\n                ? \'bg-[#141414] text-[#E4E3E0]\'\n                : \'hover:bg-white text-[#141414]\'\n            }`}\n          >\n            <Sliders className=\"w-3.5 h-3.5\" />\n            <span>Digital Twin Canvas</span>\n          </button>\n\n          <button\n            onClick={() => onSelectView(\'analytics\')}\n            className={`flex items-center space-x-2 px-3 py-2 border-r-2 border-[#141414] transition-colors whitespace-nowrap ${\n              currentView === \'analytics\'\n                ? \'bg-[#141414] text-[#E4E3E0]\'\n                : \'hover:bg-white text-[#141414]\'\n            }`}\n          >\n            <BarChart3 className=\"w-3.5 h-3.5\" />\n            <span>6-Parameter Analytics</span>\n          </button>\n\n          <button\n            onClick={() => onSelectView(\'scanner\')}\n            className={`flex items-center space-x-2 px-3 py-2 border-r-2 border-[#141414] transition-colors whitespace-nowrap ${\n              currentView === \'scanner\'\n                ? \'bg-[#141414] text-[#E4E3E0]\'\n                : \'hover:bg-white text-[#141414]\'\n            }`}\n          >\n            <Camera className=\"w-3.5 h-3.5\" />\n            <span>AI Vision Scanner</span>\n          </button>\n\n          <button\n            onClick={() => onSelectView(\'blueprint\')}\n            className={`flex items-center space-x-2 px-3 py-2 border-r-2 border-[#141414] transition-colors whitespace-nowrap ${\n              currentView === \'blueprint\'\n                ? \'bg-[#141414] text-[#E4E3E0]\'\n                : \'hover:bg-white text-[#141414]\'\n            }`}\n          >\n            <FileCode2 className=\"w-3.5 h-3.5\" />\n            <span>Architecture Blueprint</span>\n          </button>\n\n          <button\n            onClick={() => onSelectView(\'presentation\')}\n            className={`flex items-center space-x-2 px-3 py-2 border-r-2 border-[#141414] transition-colors whitespace-nowrap ${\n              currentView === \'presentation\'\n                ? \'bg-[#141414] text-[#E4E3E0]\'\n                : \'hover:bg-white text-[#141414]\'\n            }`}\n          >\n            <Presentation className=\"w-3.5 h-3.5\" />\n            <span>Google Slides</span>\n          </button>\n\n          <button\n            onClick={() => onSelectView(\'how-it-works\')}\n            className={`flex items-center space-x-2 px-3 py-2 border-r-2 border-[#141414] transition-colors whitespace-nowrap ${\n              currentView === \'how-it-works\'\n                ? \'bg-[#141414] text-[#E4E3E0]\'\n                : \'hover:bg-white text-[#141414]\'\n            }`}\n          >\n            <HelpCircle className=\"w-3.5 h-3.5\" />\n            <span>Guide</span>\n          </button>\n        </div>\n      </div>\n    </header>"
